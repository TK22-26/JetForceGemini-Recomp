@@ -761,0 +852,39 @@ bool process_instruction(GeneratorType& generator, const N64Recomp::Context& con
+static bool validate_section_relocations(
+    const N64Recomp::Context& context, const N64Recomp::Section& section)
+{
+    const uint64_t source_end = uint64_t(section.ram_addr) + section.size;
+    if (source_end > UINT64_C(0x100000000)) {
+        return false;
+    }
+    bool have_previous_address = false;
+    uint32_t previous_address = 0;
+    for (const N64Recomp::Reloc& reloc : section.relocs) {
+        if (reloc.address < section.ram_addr ||
+            uint64_t(reloc.address) + sizeof(uint32_t) > source_end ||
+            (reloc.address & 3) != 0 ||
+            (have_previous_address && reloc.address <= previous_address)) {
+            return false;
+        }
+        previous_address = reloc.address;
+        have_previous_address = true;
+
+        if (!reloc.reference_symbol && reloc.target_section != N64Recomp::SectionAbsolute) {
+            if (reloc.target_section >= context.sections.size() ||
+                reloc.target_section >= N64Recomp::RegularSectionLimit) {
+                return false;
+            }
+            const N64Recomp::Section& target = context.sections[reloc.target_section];
+            const uint64_t target_extent = target.relocation_size != 0
+                ? target.relocation_size
+                : uint64_t(target.size) + target.bss_size;
+            const uint64_t target_address = uint64_t(target.ram_addr) + reloc.target_section_offset;
+            if (reloc.target_section_offset >= target_extent ||
+                target_address > UINT32_MAX ||
+                (reloc.type == N64Recomp::RelocType::R_MIPS_26 && (target_address & 3) != 0)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
