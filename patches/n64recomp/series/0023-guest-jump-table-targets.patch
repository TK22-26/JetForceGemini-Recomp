@@ -1,0 +2 @@
+#include <algorithm>
@@ -453,0 +455,28 @@ void N64Recomp::CGenerator::emit_function_call_by_register(int reg) const {
+void N64Recomp::CGenerator::emit_guest_switch_capture(const Context& context, const JumpTable& jtbl, int reg) const {
+    emit_indirect_target_capture(reg);
+    if (context.sections[jtbl.section_index].relocatable) {
+        fmt::print(output_file, "    const int32_t guest_switch_base = section_addresses[{}];\n", jtbl.section_index);
+    }
+}
+
+void N64Recomp::CGenerator::emit_guest_switch(const Context& context, const JumpTable& jtbl) const {
+    const auto& section = context.sections[jtbl.section_index];
+    // The finite member set is still authoritative, but the runtime table is
+    // not immutable. Dispatch on JR's captured target, never its old index.
+    std::vector<uint32_t> targets = jtbl.entries;
+    std::sort(targets.begin(), targets.end());
+    targets.erase(std::unique(targets.begin(), targets.end()), targets.end());
+    if (!section.relocatable) fmt::print(output_file, "switch (guest_call_target) {{\n");
+    for (uint32_t target : targets) {
+        if (section.relocatable) {
+            fmt::print(output_file, "    if (guest_call_target == U64(ADD32(guest_switch_base, 0x{:08X}U))) goto L_{:08X};\n",
+                target - section.ram_addr, target);
+        }
+        else {
+            fmt::print(output_file, "    case U64(S32(0x{:08X}U)): goto L_{:08X};\n", target, target);
+        }
+    }
+    if (!section.relocatable) fmt::print(output_file, "    default: break;\n    }}\n");
+    fmt::print(output_file, "    switch_error((const char*)0, 0x{:08X}, 0x{:08X});\n    return;\n    }}\n", jtbl.jr_vram, jtbl.vram);
+}
+
