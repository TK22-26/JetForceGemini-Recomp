+        }
+        stream << text;
+    }
+    N64Recomp::Context parsed{};
+    const bool result = N64Recomp::Context::from_symbol_file(path, {}, parsed, true);
+    std::error_code remove_error;
+    std::filesystem::remove(path, remove_error);
+    if (result && output != nullptr) {
+        *output = std::move(parsed);
+    }
+    return result;
+}
