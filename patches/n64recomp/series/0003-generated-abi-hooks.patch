diff --git a/include/recomp.h b/include/recomp.h
index 73f3e73..31f0cd5 100644
--- a/include/recomp.h
+++ b/include/recomp.h
@@ -18,5 +18,3 @@
-    // Clang has no dedicated IPO attribute, so we use a combination of other attributes to give the desired behavior.
-    // The inline keyword allows multiple definitions during linking, and extern forces clang to emit an externally visible definition.
-    // Weak forces Clang to not perform any IPO as the symbol can be interposed, which prevents actual inlining due to the inline keyword.
-    // Add noinline on for good measure, which doesn't conflict with the inline keyword as they have different meanings.
-    #define RECOMP_FUNC extern inline __attribute__((weak,noinline))
+    // Hardened one-function-per-object output uses archive ordering for
+    // interposition, so definitions must remain strong for symbol auditing.
+    #define RECOMP_FUNC __attribute__((noinline))
@@ -41 +39 @@
-static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
+static inline void DMULT(int64_t a, int64_t b, uint64_t* lo64, uint64_t* hi64) {
@@ -44,2 +42,2 @@ static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
-    *hi64 = (int64_t)(full128 >> 64);
-    *lo64 = (int64_t)(full128 >> 0);
+    *hi64 = (uint64_t)(full128 >> 64);
+    *lo64 = (uint64_t)(full128 >> 0);
@@ -61,2 +59,5 @@ static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64
-static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
-    *lo64 = _mul128(a, b, hi64);
+static inline void DMULT(int64_t a, int64_t b, uint64_t* lo64, uint64_t* hi64) {
+    int64_t signed_hi;
+    int64_t signed_lo = _mul128(a, b, &signed_hi);
+    *lo64 = (uint64_t)signed_lo;
+    *hi64 = (uint64_t)signed_hi;
@@ -73,4 +74,13 @@ static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64
-static inline void DDIV(int64_t a, int64_t b, int64_t* quot, int64_t* rem) {
-    int overflow = ((uint64_t)a == 0x8000000000000000ull) && (b == -1ll);
-    *quot = overflow ? a : (a / b);
-    *rem = overflow ? 0 : (a % b);
+static inline void DDIV(int64_t a, int64_t b, uint64_t* quot, uint64_t* rem) {
+    if (b == 0) {
+        *quot = a >= 0 ? UINT64_MAX : UINT64_C(1);
+        *rem = (uint64_t)a;
+    }
+    else if (a == INT64_MIN && b == -1) {
+        *quot = (uint64_t)INT64_MIN;
+        *rem = 0;
+    }
+    else {
+        *quot = (uint64_t)(a / b);
+        *rem = (uint64_t)(a % b);
+    }
@@ -80,2 +90,40 @@ static inline void DDIVU(uint64_t a, uint64_t b, uint64_t* quot, uint64_t* rem)
-    *quot = a / b;
-    *rem = a % b;
+    if (b == 0) {
+        *quot = UINT64_MAX;
+        *rem = a;
+    }
+    else {
+        *quot = a / b;
+        *rem = a % b;
+    }
+}
+
+static inline uint64_t mips_sign_extend_32(uint32_t value) {
+    return (value & UINT32_C(0x80000000)) != 0
+        ? UINT64_C(0xFFFFFFFF00000000) | value
+        : value;
+}
+
+static inline void DIV32(int32_t a, int32_t b, uint64_t* quot, uint64_t* rem) {
+    if (b == 0) {
+        *quot = a >= 0 ? UINT64_MAX : UINT64_C(1);
+        *rem = (uint64_t)(int64_t)a;
+    }
+    else if (a == INT32_MIN && b == -1) {
+        *quot = mips_sign_extend_32(UINT32_C(0x80000000));
+        *rem = 0;
+    }
+    else {
+        *quot = (uint64_t)(int64_t)(a / b);
+        *rem = (uint64_t)(int64_t)(a % b);
+    }
+}
+
+static inline void DIVU32(uint32_t a, uint32_t b, uint64_t* quot, uint64_t* rem) {
+    if (b == 0) {
+        *quot = UINT64_MAX;
+        *rem = mips_sign_extend_32(a);
+    }
+    else {
+        *quot = mips_sign_extend_32(a / b);
+        *rem = mips_sign_extend_32(a % b);
+    }
@@ -438,0 +487,6 @@ gpr cop0_status_read(recomp_context* ctx);
+void cop0_write(recomp_context* ctx, uint32_t cop0_reg, gpr value);
+gpr cop0_read(recomp_context* ctx, uint32_t cop0_reg);
+void cop0_eret(uint8_t* rdram, recomp_context* ctx);
+void cache_op(uint8_t* rdram, recomp_context* ctx, uint32_t operation, gpr address);
+void cop0_tlb_op(recomp_context* ctx, uint32_t operation);
+void reserved_instruction(uint8_t* rdram, recomp_context* ctx, uint32_t vram, uint32_t word);
