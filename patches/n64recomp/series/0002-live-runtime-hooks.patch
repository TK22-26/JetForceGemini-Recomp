+void N64Recomp::LiveGenerator::emit_cop0_write(int reg, int cop0_reg) const {
+    sljit_sw src;
+    sljit_sw srcw;
+    get_gpr_values(reg, src, srcw);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, cop0_reg);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R2, 0, src, srcw);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS3V(P, 32, W), SLJIT_IMM, sljit_sw(inputs.cop0_write));
+}
+
+void N64Recomp::LiveGenerator::emit_eret() const {
+    sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R0, 0, Registers::rdram, 0, SLJIT_IMM, rdram_offset);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R1, 0, Registers::ctx, 0);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2V(P,P), SLJIT_IMM, sljit_sw(inputs.cop0_eret));
+    sljit_emit_return_void(compiler);
+}
+
+void N64Recomp::LiveGenerator::emit_cache(int base_reg, int operation, int16_t offset) const {
+    sljit_sw src;
+    sljit_sw srcw;
+    get_gpr_values(base_reg, src, srcw);
+    sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R0, 0, Registers::rdram, 0, SLJIT_IMM, rdram_offset);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R1, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R2, 0, SLJIT_IMM, operation);
+    sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R3, 0, src, srcw, SLJIT_IMM, offset);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS4V(P, P, 32, W), SLJIT_IMM, sljit_sw(inputs.cache_op));
+}
+
+void N64Recomp::LiveGenerator::emit_tlb(uint32_t operation) const {
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, operation);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2V(P,32), SLJIT_IMM, sljit_sw(inputs.cop0_tlb_op));
+}
+
+void N64Recomp::LiveGenerator::emit_reserved_instruction(uint32_t vram, uint32_t word) const {
+    sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R0, 0, Registers::rdram, 0, SLJIT_IMM, rdram_offset);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R1, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R2, 0, SLJIT_IMM, vram);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R3, 0, SLJIT_IMM, word);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS4V(P,P,32,32), SLJIT_IMM, sljit_sw(inputs.reserved_instruction));
+}
