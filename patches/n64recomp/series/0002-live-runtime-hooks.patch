+void N64Recomp::LiveGenerator::emit_cop0_read(int reg, int cop0_reg) const {
+    // The CP0 read may be observable even when its GPR result is discarded.
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, cop0_reg);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2(W, P, 32), SLJIT_IMM, sljit_sw(inputs.cop0_read));
+    if (reg != 0) {
+        sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_MEM1(Registers::ctx), get_gpr_context_offset(reg), SLJIT_R0, 0);
+    }
+}
