+#ifndef __RECOMP_INDIRECT_DECISIONS_H__
+#define __RECOMP_INDIRECT_DECISIONS_H__
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace N64Recomp {
+    class Context;
+    struct Function;
+    struct JumpTable;
+
+    inline constexpr size_t MaxIndirectDecisionEmissions = 1U << 20;
+    inline constexpr size_t MaxDirectCallEmissions = 1U << 20;
+    inline constexpr size_t MaxIndirectTargetMembers = 1U << 22;
+    inline constexpr size_t MaxGeneratedCallableMembers = 1U << 20;
+    inline constexpr size_t MaxGeneratedFunctionNameBytes = 4096;
+    inline constexpr size_t MaxDirectCallInstructionClassBytes = 64;
+    inline constexpr size_t MaxIndirectDecisionSidecarBytes = 64U << 20;
+
+    enum class IndirectDecisionClassification : uint8_t {
+        NativeReturn,
+        DynamicCall,
+        DynamicTail,
+        BoundedSwitch,
+    };
+
+    struct IndirectTargetMember {
+        uint16_t section_index;
+        uint32_t section_offset;
+
+        bool operator==(const IndirectTargetMember&) const = default;
+    };
+
+    struct IndirectDecisionEmission {
+        uint16_t source_section;
+        uint32_t source_offset;
+        uint8_t source_register;
+        IndirectDecisionClassification classification;
+        std::string generated_function;
+        std::vector<IndirectTargetMember> target_members;
+    };
+
+    enum class DirectCallClassification : uint8_t {
+        GeneratedCallable,
+        CheckedAddressLookup,
+        ReferenceSymbol,
+        EventSymbol,
+    };
+
+    enum class DirectCallTransferRole : uint8_t {
+        LinkedCall,
+        DirectTail,
+    };
+
+    struct DirectCallTarget {
+        uint32_t address = 0;
+        uint16_t section_index = 0;
+        uint32_t symbol_index = 0;
+        std::string generated_function;
+    };
+
+    struct DirectCallEmission {
+        uint16_t source_section;
+        uint32_t source_offset;
+        std::string instruction_class;
+        DirectCallTransferRole transfer_role;
+        DirectCallClassification classification;
+        std::string generated_function;
+        DirectCallTarget target;
+    };
+
+    // Capture is disabled by default so ordinary N64Recomp users pay no
+    // collection or output cost unless the CLI configuration opts in.
+    void configure_indirect_decision_capture(bool enabled);
+
+    bool record_indirect_decision(
+        const Context& context,
+        const Function& function,
+        uint32_t instruction_vram,
+        int source_register,
+        IndirectDecisionClassification classification,
+        const JumpTable* jump_table = nullptr
+    );
+
+    bool record_direct_call(
+        const Context& context,
+        const Function& function,
+        uint32_t instruction_vram,
+        std::string instruction_class,
+        DirectCallTransferRole transfer_role,
+        DirectCallClassification classification,
+        DirectCallTarget target
+    );
+
+    std::vector<IndirectDecisionEmission> get_indirect_decision_emissions();
+    std::vector<DirectCallEmission> get_direct_call_emissions();
+
+    bool write_indirect_decision_sidecar(
+        const std::filesystem::path& path,
+        const Context& context
+    );
+}
+
+#endif
