new file mode 100644
--- /dev/null
+++ b/src/indirect_decisions.cpp
@@ -0,0 +1,738 @@
+#include "recompiler/indirect_decisions.h"
+
+#include <algorithm>
+#include <fstream>
+#include <limits>
+#include <mutex>
+#include <sstream>
+#include <string_view>
+#include <tuple>
+#include <unordered_set>
+
+#include "recompiler/context.h"
+
+namespace {
+    struct CaptureState {
+        std::mutex mutex;
+        bool enabled = false;
+        size_t target_member_count = 0;
+        std::vector<N64Recomp::IndirectDecisionEmission> emissions;
+        std::vector<N64Recomp::DirectCallEmission> direct_calls;
+    };
+
+    struct CallableMember {
+        uint16_t source_section;
+        uint32_t source_offset;
+        uint32_t size;
+        std::string generated_function;
+    };
+
+    CaptureState capture_state;
+
+    bool callable_less(const CallableMember& left, const CallableMember& right) {
+        if (left.source_section != right.source_section) {
+            return left.source_section < right.source_section;
+        }
+        if (left.source_offset != right.source_offset) {
+            return left.source_offset < right.source_offset;
+        }
+        if (left.size != right.size) {
+            return left.size > right.size;
+        }
+        return left.generated_function < right.generated_function;
+    }
+
+    bool emission_less(
+        const N64Recomp::IndirectDecisionEmission& left,
+        const N64Recomp::IndirectDecisionEmission& right
+    ) {
+        return std::tie(
+            left.source_section,
+            left.source_offset,
+            left.generated_function,
+            left.classification,
+            left.source_register
+        ) < std::tie(
+            right.source_section,
+            right.source_offset,
+            right.generated_function,
+            right.classification,
+            right.source_register
+        );
+    }
+
+    bool direct_call_less(
+        const N64Recomp::DirectCallEmission& left,
+        const N64Recomp::DirectCallEmission& right
+    ) {
+        return std::tie(
+            left.source_section,
+            left.source_offset,
+            left.generated_function,
+            left.instruction_class,
+            left.transfer_role,
+            left.classification
+        ) < std::tie(
+            right.source_section,
+            right.source_offset,
+            right.generated_function,
+            right.instruction_class,
+            right.transfer_role,
+            right.classification
+        );
+    }
+
+    bool bounded_add(size_t& total, size_t amount, size_t limit) {
+        if (amount > limit || total > limit - amount) {
+            return false;
+        }
+        total += amount;
+        return true;
+    }
+
+    bool write_json_string(std::ostream& output, std::string_view value) {
+        if (value.size() > N64Recomp::MaxGeneratedFunctionNameBytes) {
+            return false;
+        }
+        static constexpr char hex[] = "0123456789abcdef";
+        output.put('"');
+        for (unsigned char character : value) {
+            switch (character) {
+            case '"': output << "\\\""; break;
+            case '\\': output << "\\\\"; break;
+            case '\b': output << "\\b"; break;
+            case '\f': output << "\\f"; break;
+            case '\n': output << "\\n"; break;
+            case '\r': output << "\\r"; break;
+            case '\t': output << "\\t"; break;
+            default:
+                if (character < 0x20) {
+                    output << "\\u00" << hex[character >> 4] << hex[character & 0x0F];
+                }
+                else {
+                    output.put(static_cast<char>(character));
+                }
+                break;
+            }
+        }
+        output.put('"');
+        return output.good();
+    }
+
+    std::string_view classification_name(
+        N64Recomp::IndirectDecisionClassification classification
+    ) {
+        switch (classification) {
+        case N64Recomp::IndirectDecisionClassification::NativeReturn:
+            return "native-return";
+        case N64Recomp::IndirectDecisionClassification::DynamicCall:
+            return "dynamic-call";
+        case N64Recomp::IndirectDecisionClassification::DynamicTail:
+            return "dynamic-tail";
+        case N64Recomp::IndirectDecisionClassification::BoundedSwitch:
+            return "bounded-switch";
+        }
+        return {};
+    }
+
+    std::string_view direct_call_classification_name(
+        N64Recomp::DirectCallClassification classification
+    ) {
+        switch (classification) {
+        case N64Recomp::DirectCallClassification::GeneratedCallable:
+            return "generated-call";
+        case N64Recomp::DirectCallClassification::CheckedAddressLookup:
+            return "checked-lookup-call";
+        case N64Recomp::DirectCallClassification::ReferenceSymbol:
+            return "reference-symbol-call";
+        case N64Recomp::DirectCallClassification::EventSymbol:
+            return "event-symbol-call";
+        }
+        return {};
+    }
+
+    bool valid_direct_call_instruction_class(std::string_view instruction_class) {
+        return !instruction_class.empty() &&
+            instruction_class.size() <= N64Recomp::MaxDirectCallInstructionClassBytes &&
+            std::all_of(
+                instruction_class.begin(),
+                instruction_class.end(),
+                [](unsigned char character) {
+                    return (character >= 'a' && character <= 'z') ||
+                        (character >= '0' && character <= '9') ||
+                        character == '_' || character == '.' || character == '-';
+                });
+    }
+
+    std::string_view direct_call_transfer_role_name(
+        N64Recomp::DirectCallTransferRole transfer_role
+    ) {
+        switch (transfer_role) {
+        case N64Recomp::DirectCallTransferRole::LinkedCall:
+            return "linked-call";
+        case N64Recomp::DirectCallTransferRole::DirectTail:
+            return "direct-tail";
+        }
+        return {};
+    }
+
+    bool same_direct_call(
+        const N64Recomp::DirectCallEmission& left,
+        const N64Recomp::DirectCallEmission& right
+    ) {
+        return left.source_section == right.source_section &&
+            left.source_offset == right.source_offset &&
+            left.instruction_class == right.instruction_class &&
+            left.transfer_role == right.transfer_role &&
+            left.classification == right.classification &&
+            left.target.address == right.target.address &&
+            left.target.section_index == right.target.section_index &&
+            left.target.symbol_index == right.target.symbol_index &&
+            left.target.generated_function == right.target.generated_function;
+    }
+
+    bool same_site_decision(
+        const N64Recomp::IndirectDecisionEmission& left,
+        const N64Recomp::IndirectDecisionEmission& right
+    ) {
+        return left.source_section == right.source_section &&
+            left.source_offset == right.source_offset &&
+            left.source_register == right.source_register &&
+            left.classification == right.classification &&
+            left.target_members == right.target_members;
+    }
+
+    bool output_within_limit(std::ostream& output) {
+        const std::streampos position = output.tellp();
+        return position >= 0 &&
+            static_cast<uint64_t>(position) <= N64Recomp::MaxIndirectDecisionSidecarBytes;
+    }
+}
+
+void N64Recomp::configure_indirect_decision_capture(bool enabled) {
+    std::lock_guard lock(capture_state.mutex);
+    capture_state.enabled = enabled;
+    capture_state.target_member_count = 0;
+    capture_state.emissions.clear();
+    capture_state.direct_calls.clear();
+}
+
+bool N64Recomp::record_indirect_decision(
+    const Context& context,
+    const Function& function,
+    uint32_t instruction_vram,
+    int source_register,
+    IndirectDecisionClassification classification,
+    const JumpTable* jump_table
+) {
+    std::lock_guard lock(capture_state.mutex);
+    if (!capture_state.enabled) {
+        return true;
+    }
+    if (capture_state.emissions.size() >= MaxIndirectDecisionEmissions ||
+        function.section_index >= context.sections.size() ||
+        source_register < 0 || source_register > 31 ||
+        function.name.empty() ||
+        function.name.size() > MaxGeneratedFunctionNameBytes) {
+        return false;
+    }
+    const Section& source_section = context.sections[function.section_index];
+    if (instruction_vram < source_section.ram_addr ||
+        instruction_vram < function.vram ||
+        function.words.size() > std::numeric_limits<uint32_t>::max() / sizeof(uint32_t)) {
+        return false;
+    }
+    const uint32_t function_size =
+        static_cast<uint32_t>(function.words.size() * sizeof(uint32_t));
+    if (instruction_vram - function.vram >= function_size) {
+        return false;
+    }
+    const uint32_t source_offset = instruction_vram - source_section.ram_addr;
+    if (source_offset >= source_section.size || (source_offset & 3U) != 0) {
+        return false;
+    }
+
+    std::vector<IndirectTargetMember> members;
+    if (classification == IndirectDecisionClassification::BoundedSwitch) {
+        if (jump_table == nullptr || jump_table->entries.empty() ||
+            jump_table->section_index != function.section_index ||
+            jump_table->entries.size() > MaxIndirectTargetMembers) {
+            return false;
+        }
+        members.reserve(jump_table->entries.size());
+        for (uint32_t target_vram : jump_table->entries) {
+            if (target_vram < source_section.ram_addr) {
+                return false;
+            }
+            const uint32_t target_offset = target_vram - source_section.ram_addr;
+            if (target_offset >= source_section.size || (target_offset & 3U) != 0) {
+                return false;
+            }
+            members.push_back({function.section_index, target_offset});
+        }
+        std::sort(
+            members.begin(),
+            members.end(),
+            [](const auto& left, const auto& right) {
+                return std::tie(left.section_index, left.section_offset) <
+                    std::tie(right.section_index, right.section_offset);
+            }
+        );
+        members.erase(std::unique(members.begin(), members.end()), members.end());
+        if (members.size() > MaxIndirectTargetMembers - capture_state.target_member_count) {
+            return false;
+        }
+    }
+    else if (jump_table != nullptr) {
+        return false;
+    }
+
+    capture_state.target_member_count += members.size();
+    capture_state.emissions.push_back({
+        function.section_index,
+        source_offset,
+        static_cast<uint8_t>(source_register),
+        classification,
+        function.name,
+        std::move(members),
+    });
+    return true;
+}
+
+std::vector<N64Recomp::IndirectDecisionEmission>
+N64Recomp::get_indirect_decision_emissions() {
+    std::lock_guard lock(capture_state.mutex);
+    return capture_state.emissions;
+}
+
+bool N64Recomp::record_direct_call(
+    const Context& context,
+    const Function& function,
+    uint32_t instruction_vram,
+    std::string instruction_class,
+    DirectCallTransferRole transfer_role,
+    DirectCallClassification classification,
+    DirectCallTarget target
+) {
+    std::lock_guard lock(capture_state.mutex);
+    if (!capture_state.enabled) {
+        return true;
+    }
+    if (capture_state.direct_calls.size() >= MaxDirectCallEmissions ||
+        function.section_index >= context.sections.size() ||
+        function.name.empty() ||
+        function.name.size() > MaxGeneratedFunctionNameBytes ||
+        instruction_vram < function.vram ||
+        function.words.size() > std::numeric_limits<uint32_t>::max() / sizeof(uint32_t)) {
+        return false;
+    }
+    const Section& source_section = context.sections[function.section_index];
+    if (instruction_vram < source_section.ram_addr) {
+        return false;
+    }
+    const uint32_t function_size =
+        static_cast<uint32_t>(function.words.size() * sizeof(uint32_t));
+    const uint32_t source_offset = instruction_vram - source_section.ram_addr;
+    if (instruction_vram - function.vram >= function_size ||
+        source_offset >= source_section.size || (source_offset & 3U) != 0) {
+        return false;
+    }
+
+    switch (classification) {
+    case DirectCallClassification::GeneratedCallable:
+        if (target.generated_function.empty() ||
+            target.generated_function.size() > MaxGeneratedFunctionNameBytes) {
+            return false;
+        }
+        break;
+    case DirectCallClassification::CheckedAddressLookup:
+        if (!target.generated_function.empty()) {
+            return false;
+        }
+        break;
+    case DirectCallClassification::ReferenceSymbol:
+        if (!target.generated_function.empty() ||
+            target.section_index == SectionEvent) {
+            return false;
+        }
+        break;
+    case DirectCallClassification::EventSymbol:
+        if (!target.generated_function.empty() || target.section_index != SectionEvent) {
+            return false;
+        }
+        break;
+    default:
+        return false;
+    }
+    if (!valid_direct_call_instruction_class(instruction_class) ||
+        direct_call_transfer_role_name(transfer_role).empty()) {
+        return false;
+    }
+
+    capture_state.direct_calls.push_back({
+        function.section_index,
+        source_offset,
+        std::move(instruction_class),
+        transfer_role,
+        classification,
+        function.name,
+        std::move(target),
+    });
+    return true;
+}
+
+std::vector<N64Recomp::DirectCallEmission>
+N64Recomp::get_direct_call_emissions() {
+    std::lock_guard lock(capture_state.mutex);
+    return capture_state.direct_calls;
+}
+
+bool N64Recomp::write_indirect_decision_sidecar(
+    const std::filesystem::path& path,
+    const Context& context
+) {
+    if (path.empty()) {
+        return false;
+    }
+    std::vector<IndirectDecisionEmission> emissions = get_indirect_decision_emissions();
+    std::vector<DirectCallEmission> direct_calls = get_direct_call_emissions();
+    if (emissions.size() > MaxIndirectDecisionEmissions ||
+        direct_calls.size() > MaxDirectCallEmissions) {
+        return false;
+    }
+    std::sort(emissions.begin(), emissions.end(), emission_less);
+    std::sort(direct_calls.begin(), direct_calls.end(), direct_call_less);
+
+    size_t target_member_count = 0;
+    std::unordered_set<std::string> emission_identities;
+    for (size_t index = 0; index < emissions.size(); ++index) {
+        const auto& emission = emissions[index];
+        if (classification_name(emission.classification).empty() ||
+            emission.generated_function.empty() ||
+            emission.generated_function.size() > MaxGeneratedFunctionNameBytes ||
+            emission.target_members.size() > MaxIndirectTargetMembers - target_member_count) {
+            return false;
+        }
+        target_member_count += emission.target_members.size();
+        const std::string identity = std::to_string(emission.source_section) + ":" +
+            std::to_string(emission.source_offset) + ":" + emission.generated_function;
+        if (!emission_identities.emplace(identity).second) {
+            return false;
+        }
+        if (index != 0 &&
+            emissions[index - 1].source_section == emission.source_section &&
+            emissions[index - 1].source_offset == emission.source_offset &&
+            !same_site_decision(emissions[index - 1], emission)) {
+            return false;
+        }
+    }
+
+    std::unordered_set<std::string> direct_call_identities;
+    for (size_t index = 0; index < direct_calls.size(); ++index) {
+        const auto& direct_call = direct_calls[index];
+        if (direct_call_classification_name(direct_call.classification).empty() ||
+            !valid_direct_call_instruction_class(direct_call.instruction_class) ||
+            direct_call_transfer_role_name(direct_call.transfer_role).empty() ||
+            direct_call.generated_function.empty() ||
+            direct_call.generated_function.size() > MaxGeneratedFunctionNameBytes ||
+            direct_call.target.generated_function.size() > MaxGeneratedFunctionNameBytes) {
+            return false;
+        }
+        const std::string identity = std::to_string(direct_call.source_section) + ":" +
+            std::to_string(direct_call.source_offset) + ":" + direct_call.generated_function;
+        if (!direct_call_identities.emplace(identity).second) {
+            return false;
+        }
+        if (index != 0 &&
+            direct_calls[index - 1].source_section == direct_call.source_section &&
+            direct_calls[index - 1].source_offset == direct_call.source_offset &&
+            !same_direct_call(direct_calls[index - 1], direct_call)) {
+            return false;
+        }
+    }
+
+    std::vector<CallableMember> callable_members;
+    callable_members.reserve(std::min(context.functions.size(), MaxGeneratedCallableMembers));
+    std::unordered_set<std::string> callable_names;
+    for (const Function& function : context.functions) {
+        if (function.ignored || function.words.empty()) {
+            continue;
+        }
+        if (callable_members.size() >= MaxGeneratedCallableMembers ||
+            function.section_index >= context.sections.size() ||
+            function.name.empty() ||
+            function.name.size() > MaxGeneratedFunctionNameBytes ||
+            !callable_names.emplace(function.name).second ||
+            function.words.size() > std::numeric_limits<uint32_t>::max() / sizeof(uint32_t)) {
+            return false;
+        }
+        const Section& section = context.sections[function.section_index];
+        if (function.vram < section.ram_addr) {
+            return false;
+        }
+        const uint32_t source_offset = function.vram - section.ram_addr;
+        const uint32_t function_size =
+            static_cast<uint32_t>(function.words.size() * sizeof(uint32_t));
+        if (source_offset >= section.size || function_size > section.size - source_offset) {
+            return false;
+        }
+        callable_members.push_back({
+            function.section_index,
+            source_offset,
+            function_size,
+            function.name,
+        });
+    }
+    std::sort(callable_members.begin(), callable_members.end(), callable_less);
+    for (const auto& emission : emissions) {
+        if (!callable_names.contains(emission.generated_function)) {
+            return false;
+        }
+    }
+    for (const auto& direct_call : direct_calls) {
+        if (!callable_names.contains(direct_call.generated_function) ||
+            (direct_call.classification == DirectCallClassification::GeneratedCallable &&
+             !callable_names.contains(direct_call.target.generated_function))) {
+            return false;
+        }
+    }
+
+    size_t estimated_bytes = 256;
+    for (const auto& member : callable_members) {
+        if (!bounded_add(
+                estimated_bytes,
+                128 + member.generated_function.size(),
+                MaxIndirectDecisionSidecarBytes)) {
+            return false;
+        }
+    }
+    for (const auto& emission : emissions) {
+        if (!bounded_add(
+                estimated_bytes,
+                256 + emission.generated_function.size(),
+                MaxIndirectDecisionSidecarBytes) ||
+            emission.target_members.size() >
+                (MaxIndirectDecisionSidecarBytes - estimated_bytes) / 80 ||
+            !bounded_add(
+                estimated_bytes,
+                emission.target_members.size() * 80,
+                MaxIndirectDecisionSidecarBytes)) {
+            return false;
+        }
+    }
+    for (const auto& direct_call : direct_calls) {
+        if (!bounded_add(
+                estimated_bytes,
+                320 + direct_call.generated_function.size() +
+                    direct_call.instruction_class.size() +
+                    direct_call.target.generated_function.size(),
+                MaxIndirectDecisionSidecarBytes)) {
+            return false;
+        }
+    }
+
+    std::ostringstream output;
+    output << "{\"decisions\":[";
+    for (size_t index = 0; index < emissions.size(); ++index) {
+        const auto& emission = emissions[index];
+        const std::string_view classification = classification_name(emission.classification);
+        if (index != 0) {
+            output.put(',');
+        }
+        output << "{\"classification\":";
+        if (!write_json_string(output, classification)) {
+            return false;
+        }
+        output << ",\"default_disposition\":";
+        const std::string_view default_disposition =
+            emission.classification == IndirectDecisionClassification::BoundedSwitch
+                ? "fail-closed-switch-error"
+                : emission.classification == IndirectDecisionClassification::NativeReturn
+                    ? "fail-closed-return-context"
+                    : "fail-closed-lookup-miss";
+        if (!write_json_string(output, default_disposition)) {
+            return false;
+        }
+        output << ",\"generated_function\":";
+        if (!write_json_string(output, emission.generated_function)) {
+            return false;
+        }
+        output << ",\"range\":{";
+        if (emission.classification == IndirectDecisionClassification::BoundedSwitch) {
+            if (emission.target_members.empty()) {
+                return false;
+            }
+            output << "\"kind\":\"exact-target-member-set\",\"members\":[";
+            for (size_t member_index = 0;
+                 member_index < emission.target_members.size();
+                 ++member_index) {
+                const auto& member = emission.target_members[member_index];
+                if (member_index != 0) {
+                    output.put(',');
+                }
+                output << "{\"target_offset\":" << member.section_offset
+                    << ",\"target_section\":" << member.section_index << '}';
+            }
+            output << ']';
+        }
+        else if (emission.classification == IndirectDecisionClassification::NativeReturn) {
+            if (!emission.target_members.empty()) {
+                return false;
+            }
+            output << "\"kind\":\"active-native-return-continuation\"";
+        }
+        else {
+            if (!emission.target_members.empty()) {
+                return false;
+            }
+            output << "\"kind\":\"generated-callable-set\"";
+        }
+        output << "},\"source_offset\":" << emission.source_offset
+            << ",\"source_register\":" << static_cast<uint32_t>(emission.source_register)
+            << ",\"source_section\":" << emission.source_section << '}';
+        if (!output_within_limit(output)) {
+            return false;
+        }
+    }
+
+    output << "],\"direct_calls\":[";
+    for (size_t index = 0; index < direct_calls.size(); ++index) {
+        const auto& direct_call = direct_calls[index];
+        if (index != 0) {
+            output.put(',');
+        }
+        output << "{\"classification\":";
+        if (!write_json_string(
+                output,
+                direct_call_classification_name(direct_call.classification))) {
+            return false;
+        }
+        output << ",\"default_disposition\":";
+        switch (direct_call.classification) {
+        case DirectCallClassification::GeneratedCallable:
+            if (!write_json_string(output, "resolved-generated-callable")) {
+                return false;
+            }
+            break;
+        case DirectCallClassification::CheckedAddressLookup:
+            if (!write_json_string(output, "fail-closed-lookup-miss")) {
+                return false;
+            }
+            break;
+        case DirectCallClassification::ReferenceSymbol:
+            if (!write_json_string(output, "resolved-reference-symbol")) {
+                return false;
+            }
+            break;
+        case DirectCallClassification::EventSymbol:
+            if (!write_json_string(output, "resolved-event-symbol")) {
+                return false;
+            }
+            break;
+        }
+        output << ",\"generated_function\":";
+        if (!write_json_string(output, direct_call.generated_function)) {
+            return false;
+        }
+        output << ",\"instruction_class\":";
+        if (!write_json_string(output, direct_call.instruction_class)) {
+            return false;
+        }
+        output << ",\"source_offset\":" << direct_call.source_offset
+            << ",\"source_section\":" << direct_call.source_section
+            << ",\"target\":{";
+        switch (direct_call.classification) {
+        case DirectCallClassification::GeneratedCallable:
+            output << "\"address\":" << direct_call.target.address
+                << ",\"generated_function\":";
+            if (!write_json_string(output, direct_call.target.generated_function)) {
+                return false;
+            }
+            output << ",\"kind\":\"generated-callable\"";
+            break;
+        case DirectCallClassification::CheckedAddressLookup:
+            output << "\"address\":" << direct_call.target.address
+                << ",\"kind\":\"runtime-address\"";
+            break;
+        case DirectCallClassification::ReferenceSymbol:
+            output << "\"kind\":\"reference-symbol\","
+                "\"section\":" << direct_call.target.section_index
+                << ",\"section_offset\":" << direct_call.target.address
+                << ",\"symbol\":" << direct_call.target.symbol_index;
+            break;
+        case DirectCallClassification::EventSymbol:
+            output << "\"kind\":\"event-symbol\","
+                "\"symbol\":" << direct_call.target.symbol_index;
+            break;
+        }
+        output << "},\"transfer_role\":";
+        if (!write_json_string(
+                output,
+                direct_call_transfer_role_name(direct_call.transfer_role))) {
+            return false;
+        }
+        output << '}';
+        if (!output_within_limit(output)) {
+            return false;
+        }
+    }
+
+    output << "],\"generated_callable_set\":{"
+        "\"kind\":\"exact-generated-callable-entry-set\","
+        "\"member_count\":" << callable_members.size() << ",\"members\":[";
+    for (size_t index = 0; index < callable_members.size(); ++index) {
+        const auto& member = callable_members[index];
+        if (index != 0) {
+            output.put(',');
+        }
+        output << "{\"generated_function\":";
+        if (!write_json_string(output, member.generated_function)) {
+            return false;
+        }
+        output << ",\"size\":" << member.size
+            << ",\"source_offset\":" << member.source_offset
+            << ",\"source_section\":" << member.source_section << '}';
+        if (!output_within_limit(output)) {
+            return false;
+        }
+    }
+    output << "]},\"kind\":\"n64recomp-indirect-decision-sidecar\","
+        "\"schema_version\":1}";
+    if (!output.good() || !output_within_limit(output)) {
+        return false;
+    }
+
+    const std::string payload = output.str();
+    if (payload.size() > MaxIndirectDecisionSidecarBytes) {
+        return false;
+    }
+    std::filesystem::path temporary_path = path;
+    temporary_path += ".tmp";
+    std::error_code remove_error;
+    std::filesystem::remove(temporary_path, remove_error);
+    std::ofstream output_file(temporary_path, std::ios::binary | std::ios::trunc);
+    if (!output_file.good()) {
+        return false;
+    }
+    output_file.write(payload.data(), static_cast<std::streamsize>(payload.size()));
+    output_file.flush();
+    const bool write_succeeded = output_file.good();
+    output_file.close();
+    if (!write_succeeded) {
+        std::filesystem::remove(temporary_path, remove_error);
+        return false;
+    }
+
+    std::filesystem::remove(path, remove_error);
+    if (remove_error) {
+        std::filesystem::remove(temporary_path, remove_error);
+        return false;
+    }
+    std::error_code rename_error;
+    std::filesystem::rename(temporary_path, path, rename_error);
+    if (rename_error) {
+        std::filesystem::remove(temporary_path, remove_error);
+        return false;
+    }
+    return true;
+}
