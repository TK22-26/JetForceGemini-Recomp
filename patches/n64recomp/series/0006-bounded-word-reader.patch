diff --git a/include/recompiler/safe_read.h b/include/recompiler/safe_read.h
new file mode 100644
index 0000000..c8942a9
--- /dev/null
+++ b/include/recompiler/safe_read.h
@@ -0,0 +1,24 @@
+#ifndef N64RECOMP_SAFE_READ_H
+#define N64RECOMP_SAFE_READ_H
+
+#include <cstdint>
+#include <cstring>
+#include <span>
+
+#include "recompiler/context.h"
+
+namespace N64Recomp {
+
+inline bool read_be_u32(std::span<const uint8_t> bytes, uint64_t offset, uint32_t& value) {
+    if (offset > bytes.size() || bytes.size() - static_cast<size_t>(offset) < sizeof(value)) {
+        return false;
+    }
+    uint32_t encoded;
+    std::memcpy(&encoded, bytes.data() + static_cast<size_t>(offset), sizeof(encoded));
+    value = byteswap(encoded);
+    return true;
+}
+
+} // namespace N64Recomp
+
+#endif
