+
+static bool outputs_to_zero(N64Recomp::Operand output, const N64Recomp::InstructionContext& context) {
+    return (output == N64Recomp::Operand::Rd && context.rd == 0)
+        || (output == N64Recomp::Operand::Rt && context.rt == 0)
+        || (output == N64Recomp::Operand::Rs && context.rs == 0);
+}
+
+static bool binary_op_reads_memory(N64Recomp::BinaryOpType type) {
+    switch (type) {
+        case N64Recomp::BinaryOpType::LD:
+        case N64Recomp::BinaryOpType::LW:
+        case N64Recomp::BinaryOpType::LWU:
+        case N64Recomp::BinaryOpType::LH:
+        case N64Recomp::BinaryOpType::LHU:
+        case N64Recomp::BinaryOpType::LB:
+        case N64Recomp::BinaryOpType::LBU:
+        case N64Recomp::BinaryOpType::LDL:
+        case N64Recomp::BinaryOpType::LDR:
+        case N64Recomp::BinaryOpType::LWL:
+        case N64Recomp::BinaryOpType::LWR:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void N64Recomp::CGenerator::emit_cop0_read(int reg, int cop0_reg) const {
+    if (reg == 0) {
+        fmt::print(output_file,
+            "do {{ volatile uint64_t discarded_read = (uint64_t)cop0_read(ctx, {}); (void)discarded_read; }} while (0);\n",
+            cop0_reg);
+    }
+    else {
+        fmt::print(output_file, "{} = cop0_read(ctx, {});\n", gpr_to_string(reg), cop0_reg);
+    }
+}
+
+void N64Recomp::CGenerator::emit_cop0_write(int reg, int cop0_reg) const {
+    fmt::print(output_file, "cop0_write(ctx, {}, {});\n", cop0_reg, gpr_to_string(reg));
+}
+
+void N64Recomp::CGenerator::emit_eret() const {
+    fmt::print(output_file, "cop0_eret(rdram, ctx);\n    return;\n");
+}
+
+void N64Recomp::CGenerator::emit_cache(int base_reg, int operation, int16_t offset) const {
+    fmt::print(output_file, "cache_op(rdram, ctx, {}, {} + {});\n", operation, gpr_to_string(base_reg), offset);
+}
+
+void N64Recomp::CGenerator::emit_tlb(uint32_t operation) const {
+    fmt::print(output_file, "cop0_tlb_op(ctx, {});\n", operation);
+}
+
+void N64Recomp::CGenerator::emit_reserved_instruction(uint32_t vram, uint32_t word) const {
+    fmt::print(output_file, "reserved_instruction(rdram, ctx, 0x{:08X}, 0x{:08X});\n", vram, word);
