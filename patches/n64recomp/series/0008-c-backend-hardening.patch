+    const bool discard_output = outputs_to_zero(op.output, ctx);
+    // Pure MIPS writes to $zero can be omitted, but loads must still perform
+    // their memory access (faults and memory-mapped reads are observable).
+    if (discard_output && !binary_op_reads_memory(op.type)) {
+        return;
+    }
@@ -572 +647,24 @@ void N64Recomp::CGenerator::process_binary_op(const BinaryOp& op, const Instruct
-    fmt::print(output_file, "{} = {};\n", output, expression);
+    if (discard_output) {
