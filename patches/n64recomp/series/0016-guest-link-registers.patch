+void N64Recomp::CGenerator::emit_guest_link(uint32_t pc, int section_index, uint32_t section_offset) const {
+    if (section_index >= 0) {
+        fmt::print(output_file, "ctx->r31 = U64(ADD32(section_addresses[{}], 0x{:08X}U));\n", section_index, section_offset);
+    }
+    else {
+        fmt::print(output_file, "ctx->r31 = U64(S32(0x{:08X}U));\n", pc);
+    }
+}
+
+void N64Recomp::CGenerator::emit_indirect_target_capture(int reg) const {
+    fmt::print(output_file, "{{ const gpr guest_call_target = {};\n", gpr_to_string(reg));
+}
+
+void N64Recomp::CGenerator::emit_captured_indirect_call() const {
+    fmt::print(output_file, "LOOKUP_FUNC(guest_call_target)(rdram, ctx); }}\n");
+}
+
 void N64Recomp::CGenerator::emit_function_call_by_register(int reg) const {
     fmt::print(output_file, "LOOKUP_FUNC({})(rdram, ctx);\n", gpr_to_string(reg));
 }
