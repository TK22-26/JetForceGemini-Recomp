  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 33554432 },
    "positiveCount": { "type": "integer", "minimum": 1, "maximum": 33554432 },
    "symbolExclusionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered-alias", "validated-non-code", "runtime-abi"],
      "properties": {
        "covered-alias": { "const": 824 },
        "validated-non-code": { "const": 0 },
        "runtime-abi": { "const": 0 }
      }
    },
    "directCallExceptionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime-abi", "fail-closed-disposition"],
      "properties": {
        "runtime-abi": { "$ref": "#/$defs/count" },
        "fail-closed-disposition": { "$ref": "#/$defs/count" }
      }
    },
    "indirectCallExceptionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail-closed-disposition"],
      "properties": {
        "fail-closed-disposition": { "$ref": "#/$defs/count" }
      }
    },
    "callClosure": {
      "type": "object",
      "required": [
        "expected_count",
        "resolved_count",
        "approved_exception_count",
        "unexplained_count",
        "approved_exception_category_counts",
        "ledger_sha256",
        "approval_set_sha256"
      ],
      "properties": {
        "expected_count": { "$ref": "#/$defs/count" },
        "resolved_count": { "$ref": "#/$defs/count" },
        "approved_exception_count": { "$ref": "#/$defs/count" },
        "unexplained_count": { "const": 0 },
        "approved_exception_category_counts": { "type": "object" },
        "ledger_sha256": { "$ref": "#/$defs/sha256" },
        "approval_set_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "relocationClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_count",
        "resolved_count",
        "approved_fail_closed_count",
        "unexplained_count",
        "ledger_sha256",
        "approval_set_sha256"
      ],
      "properties": {
        "expected_count": { "$ref": "#/$defs/count" },
        "resolved_count": { "$ref": "#/$defs/count" },
        "approved_fail_closed_count": { "$ref": "#/$defs/count" },
        "unexplained_count": { "const": 0 },
        "hi_lo_pair_count": { "$ref": "#/$defs/count" },
        "atomic_hi_lo_pair_count": { "$ref": "#/$defs/count" },
        "partial_hi_lo_pair_count": { "const": 0 },
        "ledger_sha256": { "$ref": "#/$defs/sha256" },
        "approval_set_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "compilerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_id",
        "family",
        "target_id",
        "configuration_id",
        "compiler_executable_sha256",
        "option_set_sha256",
        "source_inventory_sha256",
        "generated_compile_passed",
        "overlay_table_compile_passed",
        "minimal_runtime_link_passed",
        "forced_object_audit_passed",
        "result_sha256"
      ],
      "properties": {
        "compiler_id": {
          "type": "string",
          "pattern": "^(?:clang|gcc|msvc)-[0-9]{1,3}(?:\\.[0-9]{1,3}){0,3}$"
        },
        "family": { "enum": ["clang", "gcc", "msvc"] },
        "target_id": { "enum": ["linux-x64", "windows-x64"] },
        "configuration_id": { "enum": ["debug", "release"] },
        "compiler_executable_sha256": { "$ref": "#/$defs/sha256" },
        "option_set_sha256": { "$ref": "#/$defs/sha256" },
        "source_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "generated_compile_passed": { "const": true },
        "overlay_table_compile_passed": { "const": true },
        "minimal_runtime_link_passed": { "const": true },
        "forced_object_audit_passed": { "const": true },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sanitizerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sanitizer_id",
        "compiler_family",
        "target_id",
        "run_count",
        "issue_count",
