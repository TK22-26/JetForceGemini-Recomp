            "host_data_inventory_sha256": { "$ref": "#/$defs/sha256" },
            "relocation_table_entry_count": { "$ref": "#/$defs/count" },
            "forced_object_link_passed": { "const": true },
            "result_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "language_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generated_language", "bridge_linkage", "abi_audit_passed", "result_sha256"],
          "properties": {
            "generated_language": { "const": "c" },
            "bridge_linkage": { "const": "c-abi" },
            "abi_audit_passed": { "const": true },
            "result_sha256": { "$ref": "#/$defs/sha256" }
          }
