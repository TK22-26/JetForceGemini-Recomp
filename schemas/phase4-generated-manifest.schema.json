        "lifecycle_table_slot_count": { "const": 157 },
        "generated_populated_module_count": { "const": 155 },
        "relocation_table_entry_count": { "const": 2028 },
        "resolved_relocation_entry_count": { "const": 2028 },
        "lookup_table_member_count": { "$ref": "#/$defs/positiveCount" },
        "lifecycle_table_member_count": { "$ref": "#/$defs/positiveCount" },
        "relocation_table_member_count": { "$ref": "#/$defs/positiveCount" },
        "unresolved_relocation_entry_count": { "const": 0 },
        "missing_slot_count": { "const": 0 },
        "duplicate_slot_count": { "const": 0 },
        "forced_object_link_passed": { "const": true },
