        "normalized_run_payload_sha256",
        "generated_inventory_sha256",
        "cpu_section_inventory_sha256",
        "overlay_table_sha256",
        "lifecycle_table_sha256",
        "relocation_table_sha256",
        "report_set_sha256",
        "source_file_inventory_sha256",
        "baseline_member_inventory_sha256",
        "patch_member_inventory_sha256",
        "all_artifact_classes_match",
        "byte_equivalent_inventory",
        "passed"
      ],
      "properties": {
        "normalization_policy_id": { "const": "phase4-run-payload-v1" },
        "generation_run_count": { "type": "integer", "minimum": 2, "maximum": 1024 },
        "distinct_normalized_run_digest_count": { "const": 1 },
        "normalized_run_payload_sha256": { "$ref": "#/$defs/sha256" },
        "generated_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "cpu_section_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "overlay_table_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_table_sha256": { "$ref": "#/$defs/sha256" },
        "relocation_table_sha256": { "$ref": "#/$defs/sha256" },
        "report_set_sha256": { "$ref": "#/$defs/sha256" },
        "source_file_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_member_inventory_sha256": { "$ref": "#/$defs/sha256" },
