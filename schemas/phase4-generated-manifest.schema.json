    "config_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_case_count",
        "base_config_sha256",
        "mutated_config_set_sha256",
        "predeclared_expectation_sha256",
        "expected_change_count",
        "observed_change_count",
        "expected_category_counts",
        "observed_category_counts",
        "unexpected_change_count",
