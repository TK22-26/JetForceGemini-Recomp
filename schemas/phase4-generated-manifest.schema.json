    "gate": {
      "oneOf": [
        { "$ref": "#/$defs/syntheticGate" },
        { "$ref": "#/$defs/completionGate" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "record_class": { "const": "synthetic-example" } } },
      "then": {
        "properties": {
          "attestation": { "$ref": "#/$defs/syntheticAttestation" },
          "gate": { "$ref": "#/$defs/syntheticGate" }
        }
      },
      "else": {
        "properties": {
          "attestation": { "$ref": "#/$defs/completionAttestation" },
          "gate": { "$ref": "#/$defs/completionGate" }
        }
      }
    }
