{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical ROM revision catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "title",
          "sha1",
          "country",
          "revision",
          "size",
          "byte_order",
          "extraction_recipe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "size": {
            "type": "integer",
            "minimum": 64,
            "multipleOf": 4
          },
          "byte_order": {
            "const": "big-endian"
          },
          "extraction_recipe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          }
        }
      }
    }
  }
}
