{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jfg/schemas/task-packet.schema.json",
  "title": "Bounded JFG task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "goal",
    "scope",
    "tests_required",
    "exit_criteria",
    "stop_conditions",
    "risk"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^JFG-[A-Z]+-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsystem",
        "allowed_files"
      ],
      "properties": {
        "subsystem": {
          "type": "string",
          "minLength": 1
        },
        "allowed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 240,
            "allOf": [
              {
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
              },
              {
                "not": {
                  "pattern": "(^|/)\\.{1,2}(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)(?:\\.[Gg][Ii][Tt](?:[Mm][Oo][Dd][Uu][Ll][Ee][Ss])?|[Rr][Oo][Mm][Ss]|[Tt][Oo][Oo][Ll][Ss]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]-[Dd][Aa][Tt][Aa]|[Ee][Xx][Tt][Rr][Aa][Cc][Tt][Ee][Dd]|[Gg][Ee][Nn][Ee][Rr][Aa][Tt][Ee][Dd]|[Cc][Oo][Rr][Pp][Uu][Ss]/[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Aa][Ss][Ss][Ee][Tt][Ss]/[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Aa][Rr][Tt][Ii][Ff][Aa][Cc][Tt][Ss]/[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Cc][Aa][Pp][Tt][Uu][Rr][Ee][Ss]/[Pp][Rr][Ii][Vv][Aa][Tt][Ee])(?:/|$)"
                }
              }
            ]
          }
        }
      }
    },
    "tests_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "restricted"
      ]
    }
  }
}
