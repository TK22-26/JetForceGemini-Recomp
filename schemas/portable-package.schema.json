{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfg-recomp.invalid/schemas/portable-package.schema.json",
  "title": "Regional portable package index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "runtimes"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-beta\\.[0-9]+)?$"
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "manifest_sha256"
        ],
        "properties": {
          "revision_id": {
            "enum": [
              "jfg-us-r0",
              "jfg-pal-r0",
              "star-twins-jp-r0"
            ]
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
