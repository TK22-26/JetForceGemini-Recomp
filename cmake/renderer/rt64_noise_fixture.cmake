# Exact-image fixture only; ordinary raster noise is unchanged.
file(READ "${jfg_rt64_root}/src/render/rt64_framebuffer_renderer.cpp" jfg_noise_contents)
string(REPLACE "\r\n" "\n" jfg_noise_contents "${jfg_noise_contents}")
string(SHA256 digest "${jfg_noise_contents}")
if(NOT digest STREQUAL "73870c23b2340611b930b668d52aec9e687fd74b7da310962b7b1ef35dee015d" AND
   NOT digest STREQUAL "26df32cb959fcb42627b3bd050c854260c12eb67ba1d2f4099d363311cfaff08")
    message(FATAL_ERROR "Pinned framebuffer renderer changed")
endif()
set(old "        frameParams.viewUbershaders = ubershadersVisible;")
set(new "        if (jfg::fixed_raster_noise_fixture_enabled()) frameParams.frameCount = 0U;\n${old}")
string(FIND "${jfg_noise_contents}" "${old}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Missing fixed-noise fixture site")
endif()
string(REPLACE "${old}" "${new}" jfg_noise_contents "${jfg_noise_contents}")
set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/rt64/render/rt64_framebuffer_renderer.cpp")
file(WRITE "${generated}" "#include \"jfg/renderer/resource_worker_profile.hpp\"\n${jfg_noise_contents}")
get_target_property(sources rt64 SOURCES)
set(patched)
set(found FALSE)
foreach(unit IN LISTS sources)
    get_filename_component(name "${unit}" NAME)
    if(name STREQUAL "rt64_framebuffer_renderer.cpp")
        list(APPEND patched "${generated}")
        set(found TRUE)
    else()
        list(APPEND patched "${unit}")
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "Framebuffer renderer source missing")
endif()
set_property(TARGET rt64 PROPERTY SOURCES "${patched}")
