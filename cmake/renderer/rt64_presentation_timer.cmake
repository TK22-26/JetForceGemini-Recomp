# Preserve the pinned timer and replace only its build-tree translation unit.
set(jfg_timer_source "${jfg_rt64_root}/src/common/rt64_timer.cpp")
# Validate canonical text: Git may convert this pinned source to CRLF.
file(READ "${jfg_timer_source}" jfg_timer_contents)
string(REPLACE "\r\n" "\n" jfg_timer_contents "${jfg_timer_contents}")
string(SHA256 jfg_timer_hash "${jfg_timer_contents}")
if(NOT jfg_timer_hash STREQUAL "26acd31fb9236219441f4d5044060a041147ff6aebd445a671c6f4743cadc7cd")
    message(FATAL_ERROR "Pinned RT64 presentation timer differs")
endif()
set(jfg_timer_site "    void Timer::preciseSleepUntil(const Timestamp endTime) {")
string(FIND "${jfg_timer_contents}" "${jfg_timer_site}" jfg_timer_at)
if(jfg_timer_at EQUAL -1)
    message(FATAL_ERROR "Pinned RT64 presentation timer patch site is missing")
endif()
string(REPLACE "${jfg_timer_site}" "${jfg_timer_site}\n        if (jfg::wait_presentation_deadline(endTime)) return;"
    jfg_timer_contents "${jfg_timer_contents}")
string(REPLACE "#include \"rt64_timer.h\"" "#include \"common/rt64_timer.h\""
    jfg_timer_contents "${jfg_timer_contents}")
set(jfg_timer_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/rt64/rt64_timer.cpp")
file(WRITE "${jfg_timer_generated}" "#include \"jfg/renderer/presentation_deadline_wait.hpp\"\n${jfg_timer_contents}")
get_target_property(jfg_timer_sources rt64 SOURCES)
set(jfg_timer_patched)
set(jfg_timer_replaced FALSE)
foreach(unit IN LISTS jfg_timer_sources)
    get_filename_component(jfg_timer_name "${unit}" NAME)
    if(jfg_timer_name STREQUAL "rt64_timer.cpp")
        list(APPEND jfg_timer_patched "${jfg_timer_generated}")
        set(jfg_timer_replaced TRUE)
    else()
        list(APPEND jfg_timer_patched "${unit}")
    endif()
endforeach()
if(NOT jfg_timer_replaced)
    message(FATAL_ERROR "Pinned RT64 timer source is missing")
endif()
set_property(TARGET rt64 PROPERTY SOURCES "${jfg_timer_patched}")
