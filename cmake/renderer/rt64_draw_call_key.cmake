# The pinned draw-call key contains four tail-padding bytes on this ABI.
# Hash and compare only the checked member range; never cache an empty library.
set(jfg_draw_key_source "${jfg_rt64_root}/src/preset/rt64_preset_draw_call.cpp")
file(SHA256 "${jfg_draw_key_source}" jfg_draw_key_hash)
if(NOT jfg_draw_key_hash STREQUAL "83ad95048acb3098058acf0759d4ec9037a71e3cb3a1bb7e2cb870cf2d96e963" AND
   NOT jfg_draw_key_hash STREQUAL "c0a432a5a5debbb198c8f1d8b5514901b81ff584122a87697afc21adb6d615a7")
 message(FATAL_ERROR "Pinned RT64 draw-call key input differs")
endif()
file(READ "${jfg_draw_key_source}" jfg_draw_key_contents)
string(REPLACE "\r\n" "\n" jfg_draw_key_contents "${jfg_draw_key_contents}")
string(REPLACE "return XXH3_64bits(this, sizeof(DrawCallKey));" "static_assert(offsetof(DrawCallKey, colorCombiner) == 64 && offsetof(DrawCallKey, otherMode) == 72 && offsetof(DrawCallKey, geometryMode) == 80);\n        return XXH3_64bits(this, offsetof(DrawCallKey, geometryMode) + sizeof(geometryMode));" jfg_draw_key_contents "${jfg_draw_key_contents}")
string(REPLACE "return memcmp(this, &k, sizeof(DrawCallKey));" "return memcmp(this, &k, offsetof(DrawCallKey, geometryMode) + sizeof(geometryMode)) == 0;" jfg_draw_key_contents "${jfg_draw_key_contents}")
string(REPLACE "        // Quick lookup case." "        if (presetMap.empty()) {\n            return {cachedKeyMaterialMap.end(), cachedKeyMaterialMap.end()};\n        }\n        // Quick lookup case." jfg_draw_key_contents "${jfg_draw_key_contents}")
set(jfg_draw_key_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/rt64/preset/rt64_preset_draw_call.cpp")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/rt64/preset")
file(WRITE "${jfg_draw_key_generated}" "#include <cstddef>\n${jfg_draw_key_contents}")
get_target_property(jfg_draw_key_sources rt64 SOURCES)
set(jfg_draw_key_patched)
set(jfg_draw_key_replaced FALSE)
foreach(unit IN LISTS jfg_draw_key_sources)
 if(unit MATCHES "(^|[/\\\\])rt64_preset_draw_call\\.cpp$")
  list(APPEND jfg_draw_key_patched "${jfg_draw_key_generated}")
  set(jfg_draw_key_replaced TRUE)
 else()
  list(APPEND jfg_draw_key_patched "${unit}")
 endif()
endforeach()
if(NOT jfg_draw_key_replaced)
 message(FATAL_ERROR "Pinned RT64 draw-call key source is missing")
endif()
set_property(TARGET rt64 PROPERTY SOURCES "${jfg_draw_key_patched}")
target_include_directories(rt64 PRIVATE "${jfg_rt64_root}/src/preset")
