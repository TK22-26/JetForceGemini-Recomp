# Pre-link compatibility identity, followed by a separate post-link bundle hash.
function(jfg_json_string output value)
    string(REPLACE "\\" "\\\\" encoded "${value}")
    string(REPLACE "\"" "\\\"" encoded "${encoded}")
    string(REPLACE "\n" "\\n" encoded "${encoded}")
    string(REPLACE "\r" "\\r" encoded "${encoded}")
    string(REPLACE "\t" "\\t" encoded "${encoded}")
    set(${output} "\"${encoded}\"" PARENT_SCOPE)
endfunction()

function(jfg_attach_native_build_identity target generated audio)
    set(options "{}")
    get_cmake_property(cache_names CACHE_VARIABLES)
    list(SORT cache_names)
    foreach(name IN LISTS cache_names)
        if(name MATCHES "^JFG_[A-Z0-9_]+$")
            jfg_json_string(value "${${name}}")
            string(JSON options SET "${options}" "${name}" "${value}")
        endif()
    endforeach()
    if(WIN32)
        set(platform windows-x64)
    else()
        set(platform linux-x64)
    endif()
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "Native program bundles require a qualified 64-bit host target")
    endif()
    set(flags "${CMAKE_CXX_FLAGS}")
    foreach(configuration IN ITEMS Debug Release RelWithDebInfo MinSizeRel)
        string(TOUPPER "${configuration}" upper)
        string(APPEND flags " $<$<CONFIG:${configuration}>:${CMAKE_CXX_FLAGS_${upper}}>")
    endforeach()
    jfg_json_string(flags_json "${flags}")
    jfg_json_string(compiler_json "${CMAKE_CXX_COMPILER_ID}")
    jfg_json_string(version_json "${CMAKE_CXX_COMPILER_VERSION}")
    jfg_json_string(target_json "${CMAKE_SYSTEM_PROCESSOR}-${CMAKE_GENERATOR_PLATFORM}")
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/native-identity/$<CONFIG>")
    file(GENERATE OUTPUT "${directory}/options.json" CONTENT
        "{\"schema_version\":1,\"platform\":\"${platform}\",\"configuration\":\"$<CONFIG>\",\"compiler\":{\"id\":${compiler_json},\"version\":${version_json},\"target\":${target_json},\"flags\":${flags_json}},\"options\":${options}}\n")
    set(headers "{}")
    set(artifacts "{}")
    set(variants "{}")
    set(identity_dependencies "")
    if(JFG_BUILD_PHASE8_LIVE)
        get_filename_component(modern_root "${JFG_PHASE8_PRIVATE_AUDIO_RUNTIME_INCLUDE}/../.." ABSOLUTE)
        foreach(pair IN ITEMS "rsp|${JFG_PHASE8_PRIVATE_AUDIO_RUNTIME_INCLUDE}" "ultramodern|${modern_root}/ultramodern/include" "sdl|${jfg_rt64_root}/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/include")
            string(REPLACE "|" ";" pair "${pair}")
            list(GET pair 0 name)
            list(GET pair 1 path)
            jfg_json_string(value "${path}")
            string(JSON headers SET "${headers}" "${name}" "${value}")
        endforeach()
        foreach(pair IN ITEMS "rt64|$<TARGET_FILE:rt64>" "sdl-import|${jfg_rt64_root}/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/lib/x64/SDL2.lib" "sdl-runtime|${jfg_rt64_root}/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/lib/x64/SDL2.dll" "dxc-runtime|${jfg_rt64_root}/src/contrib/dxc/bin/x64/dxcompiler.dll" "dxil-runtime|${jfg_rt64_root}/src/contrib/dxc/bin/x64/dxil.dll")
            string(REPLACE "|" ";" pair "${pair}")
            list(GET pair 0 name)
            list(GET pair 1 path)
            jfg_json_string(value "${path}")
            string(JSON artifacts SET "${artifacts}" "${name}" "${value}")
        endforeach()
        list(APPEND identity_dependencies rt64)
    endif()
    get_target_property(native_sources ${target} SOURCES)
    foreach(path IN LISTS native_sources)
        if(path MATCHES "^${CMAKE_CURRENT_BINARY_DIR}/.*[.](inc|hpp)$")
            get_filename_component(name "${path}" NAME)
            jfg_json_string(value "${path}")
            string(JSON variants SET "${variants}" "${name}" "${value}")
            list(APPEND identity_dependencies "${path}")
        endif()
    endforeach()
    file(GENERATE OUTPUT "${directory}/dependencies.json" CONTENT
        "{\"schema_version\":1,\"headers\":${headers},\"artifacts\":${artifacts},\"variants\":${variants}}\n")
    # Always check content, including dirty source and newly added files. The
    # producer preserves the header timestamp when the identity is unchanged.
    add_custom_target(${target}-identity
        COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_SOURCE_DIR}/scripts/build/native_program_identity.py"
            --generated-root "${generated}" --audio-root "${audio}"
            --dependency-inputs "${directory}/dependencies.json"
            --options "${directory}/options.json" --output "${directory}/build-identity.hpp"
            --private-receipt "${directory}/inputs.json"
        DEPENDS ${identity_dependencies}
        BYPRODUCTS "${directory}/build-identity.hpp" "${directory}/inputs.json"
        COMMENT "Checking the native source, generation, audio and compiler identity"
        VERBATIM)
    add_dependencies(${target} ${target}-identity)
    target_compile_definitions(${target} PRIVATE "JFG_NATIVE_BUILD_HEADER=\"${directory}/build-identity.hpp\"")
endfunction()
