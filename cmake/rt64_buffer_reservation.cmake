
# A private complete dependency view keeps BufferPair layout consistent.
file(READ "${jfg_capacity_original_root}/src/render/rt64_buffer_uploader.h" jfg_reserve_header)
string(REPLACE "\r\n" "\n" jfg_reserve_header "${jfg_reserve_header}")
string(SHA256 digest "${jfg_reserve_header}")
if(NOT digest STREQUAL "04f9d99082f7369f7183dbfa04ce67ca268b56d490d1f67e3926e5889d933673")
    message(FATAL_ERROR "Pinned buffer reservation header changed")
endif()
if(JFG_RT64_BUFFER_RESERVATION)
    string(REPLACE "        uint64_t allocatedSize = 0;"
        "        uint64_t allocatedSize = 0;\n        uint64_t minimumUploadSize = 0;\n        uint64_t uploadAllocatedSize = 0;"
        jfg_reserve_header "${jfg_reserve_header}")
endif()
set(destination "${jfg_capacity_source}/src/render/rt64_buffer_uploader.h")
set(existing "")
if(EXISTS "${destination}")
    file(READ "${destination}" existing)
    string(REPLACE "\r\n" "\n" existing "${existing}")
endif()
if(NOT existing STREQUAL jfg_reserve_header)
    file(WRITE "${destination}" "${jfg_reserve_header}")
endif()

function(jfg_patch_buffer_reservation_sources)
    file(READ "${jfg_rt64_root}/src/hle/rt64_workload.cpp" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    string(SHA256 digest "${contents}")
    if(NOT digest STREQUAL "1182be7cb648251b5225e494900777ed2f8f0058148bb02a1fefeffd808d1166")
        message(FATAL_ERROR "Pinned workload reservation source changed")
    endif()
    set(old "    void Workload::uploadDrawData(RenderWorker *worker, BufferUploader *bufferUploader) {")
    set(new "${old}\n        if (jfg::buffer_reservation_enabled() && drawBuffers.rdpParamsBuffer.minimumUploadSize == 0U) {\n            BufferPair *const staging[] = {\n                &drawBuffers.positionBuffer,\n                &drawBuffers.velocityBuffer,\n                &drawBuffers.texcoordBuffer,\n                &drawBuffers.texcoordVelocityBuffer,\n                &drawBuffers.normalColorBuffer,\n                &drawBuffers.viewProjIndicesBuffer,\n                &drawBuffers.worldIndicesBuffer,\n                &drawBuffers.fogIndicesBuffer,\n                &drawBuffers.lightIndicesBuffer,\n                &drawBuffers.lightCountsBuffer,\n                &drawBuffers.lookAtIndicesBuffer,\n                &drawBuffers.faceIndicesBuffer,\n                &drawBuffers.modifyPosUintsBuffer,\n                &drawBuffers.rdpParamsBuffer,\n                &drawBuffers.rspParamsBuffer,\n                &drawBuffers.extraParamsBuffer,\n                &drawBuffers.renderParamsBuffer,\n                &drawBuffers.rdpTilesBuffer,\n                &drawBuffers.gpuTilesBuffer,\n                &drawBuffers.rspViewportsBuffer,\n                &drawBuffers.rspFogBuffer,\n                &drawBuffers.rspLightsBuffer,\n                &drawBuffers.rspLookAtBuffer,\n                &drawBuffers.worldTransformsBuffer,\n                &drawBuffers.viewProjTransformsBuffer,\n                &drawBuffers.prevWorldTransformsBuffer,\n                &drawBuffers.invTWorldTransformsBuffer,\n                &drawBuffers.triPosBuffer,\n                &drawBuffers.triTcBuffer,\n                &drawBuffers.triColorBuffer\n            };\n            for (auto *pair : staging) pair->minimumUploadSize = 512U * 1024U;\n            drawBuffers.rdpParamsBuffer.minimumUploadSize = 1024U * 1024U;\n        }\n")
    string(FIND "${contents}" "${old}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Typed RDP-parameter reservation site missing")
    endif()
    string(REPLACE "${old}" "${new}" contents "${contents}")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/rt64/rt64_workload.cpp")
    file(WRITE "${generated}" "#include \"jfg/renderer/resource_worker_profile.hpp\"\n${contents}")
    get_target_property(sources rt64 SOURCES)
    set(patched)
    set(found FALSE)
    foreach(unit IN LISTS sources)
        get_filename_component(name "${unit}" NAME)
        if(name STREQUAL "rt64_workload.cpp")
            list(APPEND patched "${generated}")
            set(found TRUE)
        else()
            list(APPEND patched "${unit}")
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Workload source missing from target")
    endif()
    set_property(TARGET rt64 PROPERTY SOURCES "${patched}")
endfunction()
