<rml><head><title>Jet Force Gemini Recomp</title><link type="text/rcss" href="theme.rcss"/><link type="text/rcss" href="about.rcss"/><link type="text/rcss" href="modern-controls.rcss"/></head><body>
<div class="home-art"><home-scene id="home-scene"/><div class="space-readout"><div id="coordinates"/><div id="heading"/></div></div>
<div class="menu"><button id="menu-game" data-action="menu-game">Game</button><button id="menu-controllers" data-action="menu-controllers">Controllers</button><button id="menu-video" data-action="menu-video">Video</button><button id="menu-audio" data-action="menu-audio">Audio</button><button id="menu-tools" data-action="menu-tools">Tools</button><button id="menu-help" data-action="menu-help">Help</button><div class="ports"><span class="pause-label">PAUSED</span><span class="port" id="p1">P1</span><span class="port" id="p2">P2</span><span class="port" id="p3">P3</span><span class="port" id="p4">P4</span></div></div>
<div class="content"><div class="kicker title-font">NATIVE PC RECOMPILATION</div><h1>JET FORCE GEMINI</h1>
<div id="rom-card"><div class="rom-library-header"><div><span class="label">GAME ROM</span><span id="rom-count">Checking loaded regions...</span></div><button id="action-rom" data-action="rom">Add ROM...</button></div><div class="rom-tiles" role="radiogroup" aria-label="Game region"><button class="rom-tile" id="action-region-us" data-action="region-us" role="radio" aria-checked="false" aria-label="USA"><rom-cartridge/><span class="rom-tile-content"><span class="rom-slot"/><span class="rom-tile-heading"><span class="rom-region">USA</span><span class="rom-state"><span class="rom-dot"/><span id="rom-state-us">EMPTY</span></span></span><span class="rom-title" id="rom-title-us">No USA ROM loaded</span><span class="rom-path" id="rom-path-us">Select, then Add ROM...</span></span></button><button class="rom-tile" id="action-region-pal" data-action="region-pal" role="radio" aria-checked="false" aria-label="PAL"><rom-cartridge/><span class="rom-tile-content"><span class="rom-slot"/><span class="rom-tile-heading"><span class="rom-region">PAL</span><span class="rom-state"><span class="rom-dot"/><span id="rom-state-pal">EMPTY</span></span></span><span class="rom-title" id="rom-title-pal">No PAL ROM loaded</span><span class="rom-path" id="rom-path-pal">Select, then Add ROM...</span></span></button><button class="rom-tile" id="action-region-jpn" data-action="region-jpn" role="radio" aria-checked="false" aria-label="JP"><rom-cartridge/><span class="rom-tile-content"><span class="rom-slot"/><span class="rom-tile-heading"><span class="rom-region">JP</span><span class="rom-state"><span class="rom-dot"/><span id="rom-state-jpn">EMPTY</span></span></span><span class="rom-title" id="rom-title-jpn">No JP ROM loaded</span><span class="rom-path" id="rom-path-jpn">Select, then Add ROM...</span></span></button></div></div><div class="actions"><button class="primary play" id="action-play" data-action="play" disabled="disabled">PLAY</button><div class="muted" id="rom-play-note">Choose a loaded region to play.</div></div><div id="update-notice" aria-label="Update available"><span class="update-icon"><span class="download-stem"/><span class="download-left"/><span class="download-right"/><span class="download-base"/></span><span class="update-copy"><span class="update-title">Update available <span id="update-version"/></span><span id="update-current" class="update-summary"/></span><span class="update-actions"><button id="update-notes" data-action="project">What's new</button><button id="update-download" data-action="releases">Update now</button></span></div></div>
<div class="footer"><span id="status">Preparing your game profile...</span><span class="footer-right"><span class="key">A</span> Play &nbsp; <span class="key">Esc</span> Menu &nbsp; <span class="key">F11</span> Fullscreen</span></div>

<div id="game-popup" class="game-popup"/>
<div id="modal" class="modal-shade"><div class="dialog" id="dialog"><div class="dialog-header"><span class="title-mark"/><span id="dialog-title"/><button class="close" data-action="close" aria-label="Close"><span class="close-cross"><span/><span/></span></button></div><div class="dialog-body" id="dialog-body"/><div class="dialog-footer"><div id="dialog-extra"/><span class="muted" id="dialog-note"/><button class="primary" id="controller-done" data-action="close"><span>Done</span></button></div><div id="modern-overlay"/></div></div>
<div id="toast" role="status" aria-live="polite" aria-relevant="additions"/>
</body></rml>
