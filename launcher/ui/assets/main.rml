<rml><head><title>Jet Force Gemini - UI preview</title><link type="text/rcss" href="theme.rcss"/></head><body>
<div class="orbit"><div class="ring r1"/><div class="ring r2"/><div class="ring r3"/><div class="ring r4"/><div class="sun"/><div class="rotor"><div class="planet"/></div><div class="rotor small"><div class="planet"/></div></div>
<div class="star" style="left:11%;top:16%;"/><div class="star" style="left:35%;top:22%;"/><div class="star" style="left:55%;top:14%;"/><div class="star" style="left:74%;top:81%;"/><div class="star" style="left:23%;top:84%;"/>
<div class="menu"><button data-action="game">Game</button><button data-action="controllers">Controllers</button><button data-action="video">Video</button><button data-action="audio">Audio</button><button data-action="tools">Tools</button><button data-action="help">Help</button><div class="ports"><span class="port" id="p1">P1</span><span class="port" id="p2">P2</span><span class="port" id="p3">P3</span><span class="port" id="p4">P4</span></div></div>
<div class="content"><div class="kicker title-font">NATIVE PC RECOMPILATION</div><h1>JET FORCE GEMINI</h1>
<div class="card"><div class="grow"><div class="label">GAME ROM <span id="rom-badge"/></div><div class="name" id="rom-name">Choose your game ROM</div><div class="muted" id="rom-folder">Required to set up and play.</div></div><button data-action="rom">Change</button></div>
<div class="actions"><button class="primary play" data-action="play">PLAY</button><div class="muted">The game starts in this window.<br/>Settings stay in the menu bar while you play.</div></div></div>
<div class="footer"><span id="status">Preparing your game profile...</span><span class="footer-right">A  Play     ESC  Menu</span></div>
<div class="pause-label">PAUSED</div>
<div id="game-popup" class="game-popup"/>
<div id="modal" class="modal-shade"><div class="dialog" id="dialog"><div class="dialog-header"><span id="dialog-title"/><button class="close" data-action="close">X</button></div><div class="dialog-body" id="dialog-body"/><div class="dialog-footer"><span class="muted" id="dialog-note"/><button class="primary" data-action="close">Done</button></div></div></div>
<div id="toast"><span id="toast-text"/></div>
</body></rml>
