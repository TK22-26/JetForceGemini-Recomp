 .mc-column { min-width:240dp; }.mc-columns { overflow-x:auto; }.mc-diagram-layout { flex-direction:column; overflow-y:auto; }.mc-diagram-list { width:auto; max-height:210dp; flex-shrink:0; }.mc-diagram-stage { min-height:430dp; flex-shrink:0; }.mc-settings-card { width:100%; }.mc-device-popover { right:12dp; width:90%; }.controllers .dialog-footer .muted { max-width:100dp; }
