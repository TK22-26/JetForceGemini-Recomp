/* Native RmlUi translation of the owner-supplied Idea 3 prototype. */
.controllers .dialog-header { height:44dp; padding-left:18dp; font-size:14dp; letter-spacing:2.8dp; }
.controllers .dialog-body { padding:0; }
.controllers.modern-layout .dialog-body { display:flex; flex-direction:column; overflow:hidden; }
.controllers .dialog-footer { height:60dp; min-height:60dp; padding:10dp 24dp; flex-wrap:nowrap; }
.controllers #dialog-extra { display:flex; align-items:center; gap:14dp; flex:1; min-width:0; }
.controllers .dialog-footer .muted { flex:0; max-width:250dp; font-size:12dp; color:#80c49a; }
.controllers .dialog-footer .primary { background:#ffb23e; color:#151820; border-color:#ffb23e; min-width:76dp; font-weight:bold; }
.controllers #dialog-extra button { font-size:12dp; padding:7dp 0; }
.mc-footer-scope { font-size:11dp; color:#657087; }
.mc-profile-header { display:flex; flex-shrink:0; align-items:center; gap:20dp; height:68dp; padding:10dp 24dp; box-sizing:border-box; border-bottom:1dp #1c2438; }
.controllers .mc-players.tabs { gap:6dp; margin:0; flex-shrink:0; flex-wrap:nowrap; }
.controllers .mc-players.tabs button { width:150dp; height:48dp; flex:none; min-width:0; padding:6dp 10dp; border-radius:7dp; background:#0e1320; border-color:#273249; }
.controllers .mc-players.tabs button.selected { border-color:#ffb23e; background:#1b2335; }
.mc-players .tab-title { display:block; font-family:Chakra Petch; font-size:11dp; letter-spacing:1.4dp; font-weight:bold; line-height:15dp; }
.mc-player-device { display:flex; align-items:center; gap:5dp; margin-top:2dp; }
.mc-players .tab-device { font-size:11dp; color:#8691a8; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; min-width:0; }
.mc-dot { display:inline-block; flex-shrink:0; width:5dp; height:5dp; border-radius:3dp; background:#576278; }
.mc-dot.online, .mc-connected.online .mc-dot { background:#6cae84; }
.mc-device { display:flex; align-items:center; justify-content:flex-end; gap:10dp; flex:1; min-width:0; }
.mc-device-text { flex:1; min-width:0; }
.mc-device-text strong { display:block; font-weight:bold; font-size:13dp; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.mc-device-text #assignment { display:block; font-size:11dp; color:#6d788e; overflow:visible; white-space:normal; }
.mc-connected { display:flex; align-items:center; gap:5dp; font-size:10dp; padding:4dp 7dp; color:#808b9e; background:#192020; border-radius:4dp; }
.mc-connected.online { color:#80b992; }
.mc-device button { font-size:12dp; padding:6dp 10dp; white-space:nowrap; border-color:#34425f; background:transparent; }
.mc-device button:last-child { padding:6dp 0; border-color:transparent; color:#647089; }
.mc-device-popover { position:absolute; right:24dp; top:105dp; width:490dp; z-index:12; background:#121826; border:1dp #354561; border-radius:8dp; }
.mc-device-popover .device-picker { margin:0; border:0; }
.mc-style { display:flex; flex-shrink:0; align-items:center; gap:12dp; padding:12dp 24dp; border-bottom:1dp #1c2438; }
.mc-section-title { display:block; font-family:Chakra Petch; font-weight:bold; font-size:11dp; letter-spacing:2.3dp; color:#77839a; }
.mc-style-label { width:104dp; flex-shrink:0; line-height:18dp; }
.mc-style-options { display:flex; gap:10dp; flex:1; min-width:0; }
.mc-button { font-size:13dp; padding:7dp 12dp; }
.mc-button.selected { border-color:#ffb23e; color:#ffc872; background:#1d2434; }
.mc-style-choice { display:flex; align-items:center; gap:12dp; flex:1; min-width:0; max-width:430dp; min-height:54dp; padding:10dp 14dp; background:#0e1320; border-color:#273249; text-align:left; border-radius:8dp; }
.mc-radio { display:flex; align-items:center; justify-content:center; width:14dp; height:14dp; border:1dp #637086; border-radius:8dp; flex-shrink:0; }
.selected .mc-radio { border-color:#ffb23e; }
.selected .mc-radio span { display:block; width:8dp; height:8dp; border-radius:4dp; background:#ffb23e; }
.mc-style-copy { flex:1; min-width:0; }
.mc-style-name { display:block; font-size:14dp; font-weight:bold; color:#e8ecf4; }
.mc-style-desc { display:block; margin-top:4dp; color:#8290a7; font-size:12dp; line-height:15dp; }
.mc-style-choice.selected .mc-style-name { color:#ffc872; }
.mc-badge { font-family:Chakra Petch; font-size:9dp; letter-spacing:1.2dp; color:#e2ac56; background:#322a20; padding:2dp 5dp; border-radius:3dp; margin-left:8dp; }
.mc-style-note { width:220dp; flex-shrink:0; font-size:11dp; color:#64718b; line-height:17dp; }
.mc-content { display:flex; flex-direction:column; flex:1; min-height:0; }
.mc-toolbar { display:flex; align-items:center; justify-content:space-between; height:46dp; min-height:46dp; margin:0 24dp; border-bottom:1dp #29334b; flex-shrink:0; gap:12dp; }
.mc-tabs { display:flex; height:100%; gap:20dp; flex-shrink:0; }
.mc-tab { height:100%; padding:0 0 1dp; border:0; border-bottom:2dp transparent; border-radius:0; background:transparent; color:#78849b; font-size:13dp; }
.mc-tab.selected { background:transparent; border-color:#ffb23e; color:#ffbd5b; }
.mc-toolbar-options { display:flex; align-items:center; gap:8dp; min-width:0; }
.mc-toolbar select { width:114dp; height:28dp; padding:4dp 8dp; font-size:12dp; border-radius:5dp; background:#151d2d; }
.mc-toolbar .mc-context-select { width:105dp; color:#94a0b5; }
.mc-symbols-label { font-size:11dp; color:#647089; }
.mc-view-toggle { font-size:12dp; padding:5dp 10dp; background:transparent; border-color:#34415a; white-space:nowrap; }
.mc-view-toggle.selected { color:#ffc872; border-color:#695333; background:transparent; }
.mc-workspace { display:flex; flex-direction:column; flex:1; min-height:0; padding:14dp 24dp 12dp; }
.mc-columns { display:flex; gap:14dp; flex:1; min-height:0; }
.mc-column { flex:1; min-width:0; overflow-y:auto; padding-right:2dp; }
.mc-binding-group { background:#0e1320; border:1dp #1c2438; border-radius:10dp; padding:2dp 6dp 6dp; margin-bottom:10dp; }
.mc-binding-group .mc-section-title { padding:10dp 8dp 8dp; }
.mc-binding-row { display:flex; align-items:center; gap:5dp; height:42dp; padding:0 4dp; border-radius:6dp; }
.mc-binding-row.selected { background:#1a2233; }
.mc-chip-space { width:45dp; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.mc-physical-name { width:82dp; color:#8590a6; font-size:12dp; flex-shrink:0; }
.mc-binding-value { display:flex; flex:1; min-width:0; height:32dp; align-items:center; gap:6dp; padding:0 9dp; background:#151d2d; border:1dp #2b3853; border-radius:6dp; font-size:13dp; text-align:left; }
.mc-binding-value > span:first-child { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.mc-row-note { font-size:10dp; color:#69768c; white-space:nowrap; }
.mc-binding-value.free { border-color:#253047; color:#62718a; }
.mc-row-clear { box-sizing:border-box; width:28dp; height:28dp; min-width:28dp; max-width:28dp; min-height:28dp; max-height:28dp; flex:none; padding:0; color:#536078; border:0; background:transparent; }
.invisible { visibility:hidden; }
.mc-chip { display:inline-flex; position:relative; box-sizing:border-box; align-items:center; justify-content:center; flex-shrink:0; font-family:Chakra Petch; font-weight:bold; color:#dce4f2; background:#151e2e; border:1dp #42516c; border-bottom-width:3dp; border-radius:24dp; }
.mc-chip.on { border-color:#ffb23e; background:#24271f; color:#ffc872; }
.mc-chip.bumper, .mc-chip.key { border-radius:6dp; }
.mc-chip.trigger-left { border-radius:12dp 12dp 5dp 5dp; transform:rotate(-6deg); }
.mc-chip.trigger-right { border-radius:12dp 12dp 5dp 5dp; transform:rotate(6deg); }
.mc-chip.mouse { border:0; background:transparent; }
.mc-menu-icon { width:14dp; height:14dp; display:flex; flex-direction:column; gap:3dp; justify-content:center; }
.mc-menu-icon span { display:block; height:1.5dp; background:#dce4f2; }
.mc-view-icon { position:relative; width:18dp; height:16dp; }
.mc-view-icon span { position:absolute; width:10dp; height:8dp; border:1dp #dce4f2; }
.mc-view-icon span:first-child { top:2dp; left:1dp; }
.mc-view-icon span:last-child { top:5dp; left:5dp; background:#151e2e; }
.mc-dpad-icon { position:relative; width:22dp; height:22dp; }
.mc-dpad-icon span { position:absolute; width:7dp; height:7dp; background:#35445e; }
.mc-dpad-icon .active { background:#b6c2d8; }
.mc-dpad-icon .d11 { left:7dp; top:0; }.mc-dpad-icon .d12 { left:7dp; top:14dp; }.mc-dpad-icon .d13 { left:0; top:7dp; }.mc-dpad-icon .d14 { left:14dp; top:7dp; }.mc-dpad-icon .dc { left:7dp; top:7dp; }
.mc-glyph-circle, .mc-glyph-square, .mc-glyph-cross { display:inline-block; box-sizing:border-box; width:14dp; height:14dp; }
.mc-glyph-circle { border:1.5dp #dce4f2; border-radius:7dp; }.mc-glyph-square { border:1.5dp #dce4f2; }
.mc-glyph-cross { position:relative; transform:rotate(45deg); }.mc-glyph-cross span { position:absolute; background:#dce4f2; }.mc-glyph-cross span:first-child { left:6dp; top:0; width:1.5dp; height:14dp; }.mc-glyph-cross span:last-child { left:0; top:6dp; width:14dp; height:1.5dp; }
.mc-glyph-triangle { display:inline-block; width:0; height:0; border-left:7dp transparent; border-right:7dp transparent; border-bottom:12dp #dce4f2; }
.mc-mouse-icon { position:relative; width:18dp; height:26dp; border:1dp #5f6f8b; border-radius:9dp; }
.mc-mouse-icon > span { position:absolute; width:5dp; height:7dp; left:6dp; top:3dp; border-radius:2dp; background:#455776; }
.mc-mouse-icon.left > span { left:2dp; width:6dp; height:10dp; background:#a9bddb; }
.mc-mouse-icon.right > span { left:10dp; width:6dp; height:10dp; background:#a9bddb; }
.mc-mouse-icon.side > span { left:-2dp; top:10dp; width:4dp; height:8dp; background:#a9bddb; }
.mc-mouse-icon .mc-mouse-motion { left:3dp; top:8dp; background:transparent; width:12dp; font-size:15dp; text-align:center; }
.mc-how { padding:2dp 14dp 12dp; }.mc-how .mc-section-title { padding-left:0; }
.mc-how p { margin:0 0 7dp; color:#77849c; font-size:12dp; line-height:18dp; }
.mc-how .mc-how-scope { color:#b0bdd2; }.mc-how-menus { margin-top:12dp; padding-top:10dp; border-top:1dp #263047; color:#637088; font-size:11dp; line-height:17dp; }
.mc-unbound-row { display:flex; align-items:center; gap:8dp; font-size:12dp; color:#8390a8; padding:5dp 8dp; }.mc-unbound-row > span { flex:1; }
.mc-unbound-row .mc-button { font-size:11dp; padding:3dp 9dp; background:transparent; }
.mc-text-button { padding:6dp 0; background:transparent; border:0; color:#75849e; font-size:12dp; }
.mc-add-key { display:block; margin:5dp 4dp; font-size:12dp; padding:5dp 8dp; color:#8697b4; background:transparent; border-color:#27344e; }
.mc-diagram-layout { display:flex; gap:14dp; flex:1; min-height:0; }
.mc-diagram-list { width:470dp; flex-shrink:0; overflow-y:auto; padding-right:3dp; }
.mc-diagram-row { display:flex; align-items:center; gap:10dp; width:100%; height:42dp; padding:0 9dp; background:transparent; border:1dp transparent; text-align:left; }
.mc-diagram-row.selected { background:#1b2335; border-color:#30405e; }
.mc-diagram-row-title { flex:1; min-width:0; font-size:13dp; }.mc-diagram-row-title.free { color:#64718a; }
.mc-diagram-stage { display:flex; flex-direction:column; flex:1; min-width:0; border:1dp #222b40; border-radius:12dp; padding:16dp 18dp; background:#0b0f17; overflow:hidden; }
.mc-art-area { display:flex; align-items:center; justify-content:center; flex:1; min-height:0; overflow:hidden; }
.mc-pad-art { position:relative; flex-shrink:0; width:560dp; height:421dp; }.mc-pad-art.ps { width:590dp; height:408dp; }
.mc-pad-art img { position:absolute; left:0; top:0; width:100%; height:100%; }
.mc-art-hit { position:absolute; transform:translate(-50%,-50%); padding:0; border:2dp transparent; border-radius:24dp; background:transparent; }
.mc-art-hit.rect { border-radius:6dp; }.mc-art-hit:hover { border-color:#61769a; background:#7590b018; }
.mc-art-hit.selected { border-color:#ffb23e; background:#ffb23e0d; }.mc-art-hit:focus { border-color:#ffdf9b; background:transparent; }
.mc-current { display:flex; align-items:center; gap:12dp; padding-top:16dp; border-top:1dp #26334c; flex-shrink:0; }
.mc-current-copy { flex:1; min-width:0; }.mc-current-copy strong { display:block; font-size:18dp; font-weight:bold; }.mc-current-copy > span { display:block; color:#74839d; font-size:12dp; margin-top:4dp; }
.mc-secondary, .mc-primary { font-size:12dp; padding:8dp 12dp; border-radius:6dp; }
.mc-primary { background:#ffb23e; color:#161b26; border-color:#ffb23e; font-weight:bold; }.mc-secondary { background:transparent; border-color:#344461; color:#9eabc1; }
.mc-diagram-rebind { align-self:flex-end; padding-bottom:0; font-size:11dp; }
.mc-keyboard-art { position:relative; width:620dp; height:420dp; flex-shrink:0; }
.mc-key { position:absolute; height:50dp; padding:7dp 4dp 4dp; background:#0e1420; border:1dp #26344d; border-bottom-width:3dp; border-radius:7dp; text-align:center; color:#465570; }
.mc-key.bound { background:#151f30; border-color:#3b527a; color:#c3d1e8; }.mc-key.selected { border-color:#ffb23e; background:#24271f; color:#ffc872; }
.mc-key strong { display:block; font-size:13dp; font-family:Chakra Petch; }.mc-key > span { display:block; font-size:10dp; margin-top:4dp; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.mc-other-title { position:absolute; top:311dp; left:0; color:#50617c; font-size:9dp; letter-spacing:1.3dp; }
.mc-other-keys { position:absolute; top:330dp; left:0; width:436dp; display:flex; gap:6dp; flex-wrap:wrap; }
.mc-other-key { padding:3dp 6dp; font-size:11dp; }.mc-other-key span { font-size:10dp; color:#657997; }
.mc-mouse-art { position:absolute; top:0; left:477dp; width:119dp; height:210dp; }.mc-mouse-art img { width:100%; height:100%; }
.mc-mouse-hit { position:absolute; background:transparent; border:1dp transparent; padding:0; border-radius:7dp; }.mc-mouse-hit.selected { border-color:#ffb23e; background:#ffb23e15; }
.mc-mouse-legend { position:absolute; top:216dp; left:452dp; width:168dp; }
.mc-mouse-row { display:flex; align-items:center; width:100%; height:23dp; padding:0 3dp; font-size:10dp; background:transparent; border:0; }.mc-mouse-row > span { width:78dp; color:#697d9e; }.mc-mouse-row strong { flex:1; font-size:10dp; font-weight:normal; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.mc-settings-scroll { flex:1; min-height:0; overflow-y:auto; padding-right:3dp; }
.mc-settings-grid { display:flex; gap:14dp; flex-wrap:wrap; align-items:flex-start; }
.mc-settings-card { width:49%; box-sizing:border-box; background:#0e1320; border:1dp #1c2438; border-radius:10dp; padding:18dp 20dp; font-size:13dp; }
.mc-settings-card > .mc-section-title { margin-bottom:20dp; }.mc-setting { margin-bottom:17dp; }.mc-setting:last-child { margin-bottom:0; }
.mc-setting-title { display:flex; align-items:center; justify-content:space-between; font-size:13dp; margin-bottom:7dp; }.mc-setting-title > span { color:#9facbf; font-size:12dp; }
.mc-setting input.volume { display:block; width:100%; height:20dp; margin:0; flex:none; }
.mc-setting input.volume slidertrack { height:5dp; margin-top:8dp; border-radius:3dp; }.mc-setting input.volume sliderbar { width:14dp; height:14dp; margin-top:3dp; background:#ffb23e; border-color:#ffca76; }.mc-setting input.volume sliderprogress { height:5dp; }
.mc-hint { display:block; color:#64728a; font-size:11dp; line-height:16dp; margin-top:6dp; }
.mc-switch-row { display:flex; justify-content:space-between; align-items:center; gap:12dp; margin-top:16dp; }.mc-switch-row > span { flex:1; }.mc-switch-row strong { font-size:13dp; font-weight:normal; }.mc-switch-row .mc-hint { margin-top:3dp; }
.mc-switch { display:flex; align-items:center; width:34dp; height:19dp; padding:2dp; border-radius:10dp; border:1dp #344059; background:#1e293c; flex-shrink:0; }.mc-switch > span { width:13dp; height:13dp; border-radius:7dp; background:#93a3ba; }.mc-switch.selected { justify-content:flex-end; background:#b97c29; border-color:#ffb23e; }.mc-switch.selected > span { background:#ffdc9c; }
.mc-segment { display:flex; gap:5dp; margin:9dp 0 5dp; }.mc-segment .mc-button { font-size:12dp; padding:6dp 12dp; background:transparent; border-color:#2a3650; }.mc-segment .mc-button.selected { color:#ffc872; border-color:#7a5d32; background:#22251f; }
.mc-zoom-example { display:flex; align-items:center; gap:14dp; border-top:1dp #202d43; padding-top:14dp; margin-top:14dp; }
.mc-crosshair { position:relative; display:inline-block; width:48dp; height:48dp; border:1dp #285163; border-radius:25dp; flex-shrink:0; }.mc-crosshair span { position:absolute; background:#467e90; }.mc-crosshair span:first-child { width:1dp; height:34dp; top:7dp; left:23dp; }.mc-crosshair span:nth-child(2) { width:34dp; height:1dp; top:23dp; left:7dp; }.mc-crosshair i { position:absolute; left:21dp; top:21dp; width:4dp; height:4dp; border-radius:2dp; background:#b0d7df; }
.mc-zoom-levels { display:flex; align-items:flex-end; gap:7dp; height:22dp; }.mc-zoom-levels span { width:18dp; height:11dp; border:1dp #375563; border-radius:2dp; }.mc-zoom-levels span:nth-child(2) { height:16dp; }.mc-zoom-levels span:last-child { height:21dp; border-color:#78bccb; background:#264550; }
.mc-capability-note { color:#697790; font-size:12dp; line-height:19dp; }.mc-advanced { margin-top:10dp; }
.mc-offline-note, .mc-warning { color:#c4a670; padding:8dp 12dp; margin-bottom:8dp; background:#252219; border-radius:5dp; font-size:12dp; flex-shrink:0; }
.mc-button-row { display:flex; gap:8dp; flex-wrap:wrap; }
#modern-overlay { display:none; position:absolute; left:0; top:0; width:100%; height:100%; z-index:30; }
.mc-overlay-shade { position:absolute; left:0; top:0; width:100%; height:100%; background:#050910c9; }
.mc-overlay-panel { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:560dp; max-width:90%; height:360dp; max-height:86%; display:flex; flex-direction:column; background:#121826; border:1dp #354462; border-radius:12dp; }
.mc-panel-picker, .mc-panel-palette { height:720dp; }.mc-panel-capture, .mc-panel-save-error { height:270dp; }.mc-panel-conflict { width:520dp; height:410dp; border-color:#765a34; }
.mc-overlay-title { display:flex; align-items:center; gap:12dp; flex-shrink:0; font-family:Chakra Petch; font-weight:bold; font-size:17dp; padding:20dp 24dp; border-bottom:1dp #253149; }
.mc-overlay-body { padding:16dp 24dp; overflow-y:auto; flex:1; min-height:0; font-size:13dp; line-height:19dp; }
.mc-overlay-body p { margin:0 0 12dp; }.mc-overlay-body .muted { font-size:12dp; color:#76859e; }
.mc-overlay-actions { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:8dp; padding:14dp 24dp; border-top:1dp #253149; flex-shrink:0; }
.mc-picker-row { display:flex; align-items:center; gap:10dp; margin-bottom:6dp; }.mc-picker-row .mc-button:first-child { flex:1; text-align:left; min-height:44dp; background:#151e2d; }.mc-picker-row .muted { width:100dp; font-size:12dp; }.mc-picker-row .mc-button:last-child { font-size:12dp; }
.mc-capture { padding:18dp 0; }.mc-card-title { font-size:17dp; margin-bottom:14dp; }
@media (max-width:1190dp) {
 .controllers .mc-players.tabs button { width:118dp; }.mc-device-text { display:none; }.mc-style-note { width:155dp; }.mc-style-label { width:75dp; }
 .mc-physical-name { display:none; }.mc-symbols-label { display:none; }.mc-diagram-list { width:330dp; }
 .mc-pad-art { width:475dp; height:357dp; }.mc-pad-art.ps { width:485dp; height:335dp; }.mc-keyboard-art { transform:scale(0.8); width:620dp; margin-left:-60dp; margin-right:-60dp; }
 .mc-current { flex-wrap:wrap; }.mc-current-copy { min-width:140dp; }.mc-secondary { font-size:11dp; }
}
@media (max-width:940dp) {
 .controllers .mc-players.tabs button { width:102dp; }.mc-connected { display:none; }.mc-profile-header { gap:12dp; padding-left:16dp; padding-right:16dp; }
 .mc-style { padding-left:16dp; padding-right:16dp; }.mc-style-note { display:none; }.mc-style-label { width:65dp; }.mc-style-choice { padding:8dp 10dp; }.mc-style-desc { font-size:11dp; }.mc-badge { margin-left:4dp; font-size:8dp; }
 .mc-toolbar { margin:0 16dp; }.mc-workspace { padding:12dp 16dp; }.mc-tabs { gap:14dp; }.mc-toolbar-options { gap:5dp; }.mc-view-toggle { font-size:11dp; padding:5dp 6dp; }.mc-toolbar select { width:96dp; }.mc-toolbar .mc-context-select { width:95dp; }
 .mc-diagram-list { width:270dp; }.mc-pad-art { width:370dp; height:278dp; }.mc-pad-art.ps { width:380dp; height:263dp; }.mc-keyboard-art { transform:scale(0.62); margin-left:-118dp; margin-right:-118dp; }
 .mc-settings-card { width:48%; padding:14dp 16dp; }.mc-row-note { display:none; }.mc-columns { gap:10dp; }.mc-current { gap:8dp; }.mc-current-copy strong { font-size:16dp; }.mc-secondary { display:none; }.mc-footer-scope { display:none; }
}
@media (max-width:700dp) {
