/* Supersampled vector details avoid dropped thin pixels at 125%/150% DPI.
   Nine-patch corners keep their radius instead of stretching with row width. */
@spritesheet mc-details {
 src: controls-art/ui-details.tga;
 resolution: 4x;
 mc-frame-on: 0px 0px 128px 128px;
 mc-frame-on-inner: 40px 40px 48px 48px;
 mc-frame-muted: 128px 0px 128px 128px;
 mc-frame-muted-inner: 168px 40px 48px 48px;
}
.mc-radio, .selected .mc-radio { width:16dp; height:16dp; border:0; background:transparent; }
.mc-crosshair { width:44dp; height:44dp; border:0; background:transparent; }
.mc-binding-row, .mc-diagram-row, .mc-style-choice, .mc-segment .mc-button { border-width:1dp; }
.mc-style-choice { border-color:transparent; background:transparent; decorator:ninepatch(mc-frame-muted, mc-frame-muted-inner) border-box; }
.mc-binding-row.selected, .mc-diagram-row.selected, .mc-style-choice.selected, .mc-segment .mc-button.selected {
 border-color:transparent; background:transparent; decorator:ninepatch(mc-frame-on, mc-frame-on-inner) border-box;
}
.mc-style-choice:hover, .mc-style-choice:focus { background:transparent; }

.controllers.modern-layout #dialog-note { color:#ffc872; }

.mc-tab, .mc-tab > span { white-space:nowrap; }
.mc-tab > span { flex-shrink:0; }

/* Both input styles use the same prototype chrome and original-mapping cards. */
.mapping-workspace { overflow-y:auto; }
.mapping-presets { display:flex; align-items:center; gap:10dp; margin-bottom:14dp; flex-shrink:0; }
.mapping-presets > .mc-button { font-size:11dp; font-weight:bold; height:28dp; padding:0 10dp; display:flex; align-items:center; justify-content:center; }
.mapping-presets .mc-segment { margin:0; padding:2dp; width:172dp; flex-shrink:0; }
.mapping-presets .mc-segment .mc-button { height:26dp; font-size:11dp; }
.mapping-presets .mc-hint { margin:0; }
.mapping-divider { width:1dp; height:22dp; background:#29334b; flex-shrink:0; }
.mapping-help { flex:1; min-width:0; }
.mapping-cards { display:flex; align-items:flex-start; gap:14dp; }
.mapping-column { flex:1; min-width:0; }
.mapping-card { padding:2dp 6dp 8dp; }
.mapping-card .mc-section-title { padding:10dp 7dp 8dp; }
.mapping-row { height:40dp; padding:0 6dp; gap:8dp; }
.mapping-label { width:76dp; flex-shrink:0; font-weight:bold; font-size:12dp; }
.mapping-value { height:32dp; padding:0 7dp; gap:9dp; }
.mapping-value .mc-prototype-chip { flex-shrink:0; }
.mapping-value > .mapping-binding-name { flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.mapping-unbound { width:24dp; flex:none; text-align:center; }
.mapping-art { height:260dp; flex-shrink:0; align-self:center; width:480dp; margin-bottom:16dp; }
.mapping-art .mc-pad-art { width:100%; height:100%; }
.mc-symbols-label { display:flex; align-items:center; height:28dp; margin:0; line-height:28dp; }
.mc-toolbar select { padding:0 7dp; line-height:26dp; }
.mc-toolbar select selectvalue { height:26dp; line-height:26dp; padding:0; }
.mc-toolbar selectarrow { margin-top:10dp; }
.mc-overlay-close { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:32dp; height:32dp; min-width:32dp; padding:0; flex-shrink:0; line-height:32dp; }
.mc-overlay-close > span { display:block; text-align:center; flex:none; line-height:24dp; }
.mc-device-text { flex:none; width:178dp; text-align:right; }
.mc-device-text strong { font-size:12dp; line-height:17dp; }
.mc-device-text #assignment { font-size:10dp; line-height:15dp; }
.mc-connected { border-radius:12dp; padding:4dp 8dp; font-size:10dp; white-space:nowrap; flex-shrink:0; }
.mc-device .mc-device-change { display:flex; align-items:center; justify-content:center; gap:8dp; min-width:108dp; height:30dp; padding:0 10dp; font-size:12dp; background:#161d2e; border-radius:6dp; }
.mc-chevron { width:4dp; height:4dp; border-right:1dp #8d99ae; border-bottom:1dp #8d99ae; transform:rotate(45deg); margin-top:-2dp; flex-shrink:0; }
.mc-device button:last-child { display:flex; align-items:center; justify-content:center; min-width:48dp; height:30dp; padding:0 4dp; font-size:12dp; color:#a5afc1; }
.mc-device button:last-child.disabled { color:#647089; }
.mc-row-clear { display:flex; align-items:center; justify-content:center; }
@media (max-width:940dp) {
 .mc-device-text { width:155dp; }
 .mapping-presets { flex-wrap:wrap; }.mapping-help { flex-basis:100%; }
 .mapping-label { width:65dp; }.mapping-row { gap:5dp; padding:0 3dp; }
}
@media (max-width:700dp) {
 .mapping-cards { flex-direction:column; }.mapping-column { width:100%; }
 .mc-device-text { width:160dp; }.mc-device .mc-device-change { min-width:100dp; }
}

.mc-overlay-close { background:transparent; border-radius:6dp; }
.mc-overlay-close:hover { background:#303e57; color:#e8ecf4; }

.mc-symbols-label { flex-shrink:0; }
.mc-symbols-label > span { flex-shrink:0; white-space:nowrap; line-height:14dp; }
.mapping-value > .mapping-unbound { flex:none; width:24dp; }
.mapping-value.free { background:transparent; }
.mc-device { gap:8dp; }
.mc-device-text { width:165dp; }

@media (max-width:1190dp) { .mc-symbols-label { display:none; } }

.mapping-value > span.mapping-unbound:first-child { flex:none; width:24dp; min-width:24dp; }
.mapping-art { width:auto; height:auto; display:flex; flex:none; }
.mapping-art .mc-pad-art { width:360dp; height:271dp; }
.mapping-art .mc-pad-art.ps { width:392dp; height:271dp; }

.mc-device-text #assignment { margin:2dp 0 0; }

/* Explicit geometry centers the cross itself, independent of font bearings. */
.mc-close-icon { position:relative; display:block; width:10dp; height:10dp; flex:none; line-height:0; }
.mc-close-icon > span { position:absolute; left:0; top:50%; margin-top:-1dp; width:10dp; height:2dp; border-radius:1dp; background:#8691a8; transform:rotate(45deg); }
.mc-close-icon > span:last-child { transform:rotate(-45deg); }
.mc-row-clear .mc-close-icon { width:8dp; height:8dp; }
.mc-row-clear .mc-close-icon > span { width:8dp; background:#64718b; }
.mc-row-clear:hover .mc-close-icon > span, .mc-overlay-close:hover .mc-close-icon > span { background:#e8ecf4; }
.mc-key-group .mc-chip-space { width:60dp; min-width:60dp; justify-content:flex-start; }
.mc-key-group .mc-chip.key { max-width:60dp; overflow:hidden; }
.mc-key-group .mc-physical-name { width:88dp; }
