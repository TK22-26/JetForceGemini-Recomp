.mc-style-note .mc-switch > span { width:12dp; height:12dp; }
@media (max-width:940dp) { .mc-tabs { gap:12dp; }.mc-tab { font-size:12dp; }.mc-toolbar select { width:130dp; max-width:130dp; }.mc-style-note { display:block; width:145dp; }.mc-style-label { display:none; } }
