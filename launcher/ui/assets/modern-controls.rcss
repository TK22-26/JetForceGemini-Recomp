.mc-pad-mini > span { position:absolute; left:3dp; top:4dp; width:4dp; height:1dp; background:#c9d4e5; }
.mc-pad-mini > i { position:absolute; right:3dp; top:3dp; width:2dp; height:2dp; background:#c9d4e5; border-radius:1dp; }
@media (max-width:940dp) { .mc-device button { min-width:0; }.mc-device button:last-child { min-width:0; }.mc-view-toggle { padding:5dp 6dp; font-size:11dp; gap:5dp; }.mc-pad-mini { display:none; } }

/* Owner live-review corrections: compact chrome and independent settings columns. */
.controllers .dialog-header { display:none; }
.controllers .dialog-footer .primary { display:flex; align-items:center; justify-content:center; height:36dp; padding:0 16dp; }
.controllers #dialog-extra > .mc-button:first-child { display:flex; align-items:center; justify-content:center; border:1dp #34425f; background:#161d2e; border-radius:6dp; height:36dp; padding:0 14dp; }
.controllers #dialog-extra > .mc-button:first-child:hover { background:#222d43; border-color:#647089; }
