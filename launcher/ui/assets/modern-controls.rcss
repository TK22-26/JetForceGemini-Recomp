.mc-settings-grid { flex-wrap:nowrap; align-items:flex-start; }
.mc-settings-column { display:flex; flex-direction:column; gap:14dp; flex:1; min-width:0; }
.mc-settings-column .mc-settings-card { width:100%; min-width:0; flex:none; }
.mc-toolbar select { box-sizing:border-box; width:138dp; max-width:138dp; min-width:0; height:28dp; padding:3dp 6dp; border:1dp #2e3a57; background:#0e1320; font-size:11dp; }
.mc-toolbar select selectvalue { padding:0 3dp; }
.mc-toolbar selectarrow { width:4dp; height:4dp; margin-right:3dp; margin-top:5dp; }
.mc-view-toggle { height:28dp; padding:0 10dp; font-size:12dp; }
.mc-pad-icon { width:18dp; height:14dp; flex-shrink:0; }
