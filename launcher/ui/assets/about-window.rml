#dialog { position:relative; left:0; top:0; transform:none; width:100%; height:100%; max-width:none; max-height:none; border:0; border-radius:0; }
.dialog-body { max-height:none; }
.dialog-footer { justify-content:flex-end; }
</style></head><body class="help about-window">
