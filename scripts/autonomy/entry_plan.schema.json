{
  "type": "object",
  "properties": {
    "operation": {"type": "string", "enum": ["entry-gpr", "needs-instrumentation"]},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 600},
    "alternative": {"type": "string", "minLength": 1, "maxLength": 600},
    "reason": {"type": "string", "minLength": 1, "maxLength": 600},
    "probe": {"anyOf": [
      {"type": "null"},
      {"type": "object", "properties": {
        "entry_pc": {"type": "string", "pattern": "^0x80[0-3][0-9a-f]{5}$"},
        "call_pc": {"type": "string", "pattern": "^0x80[0-3][0-9a-f]{5}$"}
      }, "required": ["entry_pc", "call_pc"], "additionalProperties": false}
    ]},
    "prediction": {"anyOf": [
      {"type": "null"},
      {"type": "object", "properties": {
        "update": {"type": "integer", "minimum": 1},
        "register": {"type": "integer", "minimum": 0, "maximum": 31},
        "relation": {"type": "string", "enum": ["equal", "different"]}
      }, "required": ["update", "register", "relation"], "additionalProperties": false}
    ]}
  },
  "required": ["operation", "hypothesis", "alternative", "reason", "probe", "prediction"],
  "additionalProperties": false
}
